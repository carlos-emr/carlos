#!/usr/bin/env sh

command=$1
PID_FILE=${CATALINA_PID:-/tomcat.pid}

is_tomcat_pid() {
  pid="$1"
  [ -n "$pid" ] || return 1
  ps -p "$pid" -o args= 2>/dev/null | grep -q 'org.apache.catalina.startup.Bootstrap'
}

case $command in
  log)
    tail -f /usr/local/tomcat/logs/catalina.out
    ;;

  start)
    # The eForm PDF and measurement-chart renderer needs a running chromedriver on loopback
    # (eform_pdf_browser_service_url); start the image's matching driver beside Tomcat.
    if command -v chromedriver >/dev/null 2>&1 && ! pgrep -f 'chromedriver --port=9515' >/dev/null 2>&1; then
      nohup chromedriver --port=9515 --allowed-ips=127.0.0.1 > /tmp/chromedriver.log 2>&1 &
      echo "chromedriver started on 127.0.0.1:9515 (log: /tmp/chromedriver.log)"
    fi
    export CATALINA_PID="$PID_FILE"
    catalina.sh jpda start

    sleep 2
    JAVA_PID=""
    if [ -f "$PID_FILE" ]; then
      JAVA_PID=$(cat "$PID_FILE")
    fi
    if is_tomcat_pid "$JAVA_PID"; then
      echo "Tomcat/Java PID: $JAVA_PID"
    else
      echo "Tomcat did not write a valid Bootstrap PID to $PID_FILE"
      rm -f "$PID_FILE"
      exit 1
    fi
    ;;

  stop)
    pkill -f 'chromedriver --port=9515' 2>/dev/null || true
    export CATALINA_PID="$PID_FILE"
    catalina.sh stop

    if [ -f "$PID_FILE" ]; then
      JAVA_PID=$(cat "$PID_FILE")
      if is_tomcat_pid "$JAVA_PID"; then
        echo "Killing Tomcat/Java PID: $JAVA_PID"
        kill "$JAVA_PID"
      fi
      rm -f "$PID_FILE"
    fi
    ;;

  restart)
    server stop
    sleep 2
    server start
    ;;
esac
