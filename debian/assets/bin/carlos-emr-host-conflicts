#!/bin/sh
# carlos-emr-host-conflicts — find, and where it is safe stop, what on this
# host keeps the CARLOS front door or database from starting.
#
# Why it exists: a 2026.08.0-beta2 fresh install on an Ubuntu 26.04 VM found
# another program already listening on 0.0.0.0:80. The distribution's nginx
# could not start, MariaDB would not answer root on its unix socket, and the
# postinst said only "nginx reload failed" and "could not reach MariaDB". The
# tester read an unprivileged netstat (no process names) and suspected the
# wrong program (#5439). This names the program, and stops it when that is
# safe.
#
#   front-door [--plan | --report | --approved UNITS] BIND_IP
#       Ports 80 and 443 belong to nginx.service. Any OTHER system service
#       listening there on an address that collides with BIND_IP
#       (CARLOS_BIND_IP) is stopped and disabled, whatever installed it:
#       a Debian package (apache2, lighttpd, haproxy, caddy, ...), a snap
#       (Ubuntu Server's installer offers the Nextcloud snap, which serves
#       80/443), or a unit an administrator wrote. A service that cannot be
#       disabled (no [Install] section, pulled in by another unit) is masked
#       instead, or the next boot would start it again and race nginx for the
#       port. Nothing is uninstalled: the operator can move it to other ports
#       and enable it again. A /usr/sbin/policy-rc.d that forbids stopping a
#       service (exit 101 or 106, as deb-systemd-invoke reads it) is obeyed:
#       that service is only named. Never stopped, only named: containers and
#       the container engines (stopping one stops every container on the
#       host), programs started by hand (an nginx started outside
#       nginx.service included: a process is not a service, and a PID is not
#       a safe handle to signal), ssh, systemd, dbus, network management,
#       database servers and CARLOS's own units. --plan lists what a run without it would stop
#       ("will-stop:") and what it would leave ("blocked:"), so the postinst
#       can ask an interactive operator first; --report names every colliding
#       listener as "blocked:". Neither changes anything.
#
#       Consent binds to what was shown. --plan also prints one
#       "will-stop-unit:" line per unit it would stop (a socket's triggered
#       services included), and a caller that asked an operator passes exactly
#       those units back with --approved (whitespace-separated, one argument).
#       The stop run re-scans, because the ports may have changed while the
#       question was open, and stops only a unit found by BOTH the plan and the
#       fresh scan: anything that took a port while the operator was reading
#       is left running and named as "blocked:", never stopped unseen (#6060).
#       Every service a socket starts must also be approved. Stop sockets
#       before stopping the services they trigger, and hold those services if
#       any of their colliding sockets stays up. Leave units with systemd stop
#       propagation for manual handling. When disabling could affect another
#       unit via [Install] Also=, mask only the approved unit instead.
#       An empty --approved stops nothing. The legacy form without a flag
#       reports conflicts for callers that cannot supply the approved list.
#   mariadb
#       Why root cannot reach MariaDB over the unix socket: the service is
#       stopped or failed (and what holds 3306, or its last [ERROR] line), it
#       was still starting, or root@localhost needs a password. Read-only:
#       a database server is never stopped from here.
#
# Output, one line each:
#   will-stop: <what a run without --plan would stop>     (--plan only)
#   will-stop-unit: <one unit behind a will-stop: line>    (--plan only)
#   stopped: <what was stopped, and how to undo it>
#   blocked: <a listener left in place, and what to do about it>
#   cause: <why root cannot reach MariaDB>          (mariadb only)
# Exit status: front-door 0 when no colliding listener is left, 1 when one
# is, 2 when the listeners cannot be read; mariadb 0 when a cause was named,
# 1 when none was found.
#
# Two callers: carlos-emr.postinst (configure) and, through the shipped path,
# carlos-ctl. Keep it `dash -n`-clean and free of bashisms. Run as root:
# without it ss cannot name another user's process.

LC_ALL=C
export LC_ALL
# No pathname expansion anywhere: unit lists are split on whitespace
# (--approved, a socket's Triggers), and a unit name (a backslash escape such
# as foo\x2dbar.service) must never be matched against files in the
# directory this happens to run from.
set -f

# printf, not echo: dash's echo expands backslashes, and these lines carry
# unit names, process names and MariaDB's own error text.
say() {
    printf '%s\n' "$*"
}

usage() {
    say "usage: carlos-emr-host-conflicts front-door [--plan | --report | --approved UNITS] BIND_IP | mariadb" >&2
    exit 2
}

# One line per listening socket on TCP port $1: "ADDRESS NAME PID", or
# "ADDRESS - -" when ss shows no owner. Status 2 when ss cannot run.
listeners() {
    command -v ss >/dev/null 2>&1 || return 2
    ss_out="$(ss -ltnpH "sport = :$1" 2>/dev/null)" || return 2
    [ -n "${ss_out}" ] || return 0
    printf '%s\n' "${ss_out}" | awk '
        NF < 4 { next }
        {
            addr = $4; s = $0; owners = 0
            while (match(s, /\("[^"]*",pid=[0-9]+/)) {
                t = substr(s, RSTART + 2, RLENGTH - 2)
                s = substr(s, RSTART + RLENGTH)
                i = index(t, "\",pid=")
                name = substr(t, 1, i - 1)
                pid = substr(t, i + 6)
                gsub(/[^A-Za-z0-9._@+:-]/, "_", name)
                if (name == "") name = "_"
                owners++
                if (!((addr SUBSEP pid) in seen)) { seen[addr SUBSEP pid] = 1; print addr, name, pid }
            }
            if (!owners) print addr, "-", "-"
        }'
}

# The host part of an ss local address: 0.0.0.0:80 -> 0.0.0.0,
# [::1]:80 -> ::1, *:80 -> *, 127.0.0.53%lo:53 -> 127.0.0.53.
host_of() {
    h="${1%:*}"
    h="${h#\[}"
    h="${h%"]"}"
    printf '%s\n' "${h%%%*}"
}

# Would nginx binding BIND_IP ($2) on the same port fail against a listener
# on host $1? Linux refuses a specific bind under a same-family wildcard and a
# wildcard over any same-family address; "*" is a dual-stack socket, which
# collides with everything. The wildcard front door also binds [::] when the
# host has IPv6, so it collides with every listener on the port.
collides() {
    case "$2" in
        '' | 0.0.0.0 | :: | '*') return 0 ;;
    esac
    [ "$1" = '*' ] && return 0
    [ "$1" = "$2" ] && return 0
    case "$2" in
        *:*) [ "$1" = :: ] ;;
        *) [ "$1" = 0.0.0.0 ] ;;
    esac
}

# The systemd unit a process runs in, or nothing when it cannot be told.
unit_of() {
    u="$(ps -o unit= -p "$1" 2>/dev/null | awk 'NF { print $1; exit }')"
    case "$u" in
        '' | -) return 1 ;;
    esac
    printf '%s\n' "$u"
}

# The socket unit systemd listens on ADDRESS ($1) for (socket activation: the
# owner ss shows is systemd itself).
socket_unit_for() {
    systemctl list-sockets --all --no-legend 2>/dev/null | awk -v a="$1" '$1 == a { print $2; exit }'
}

# The Debian package that ships unit $1, or nothing (an administrator's own
# unit under /etc/systemd/system, a snap, a generated transient unit).
package_of() {
    for prop in FragmentPath SourcePath; do
        p="$(systemctl show --property="${prop}" --value "$1" 2>/dev/null)"
        [ -n "$p" ] || continue
        # usrmerge: a package may still register its unit under /lib.
        for q in "$p" "${p#/usr}"; do
            r="$(dpkg-query -S "$q" 2>/dev/null | awk -F': ' 'NF > 1 && $1 !~ /^diversion / { print $1; exit }')"
            if [ -n "$r" ]; then
                printf '%s\n' "$r"
                return 0
            fi
        done
    done
    return 1
}

# Units that are never stopped from here: the owner of the port itself, the
# container engines (stopping one stops every container on the host, snap
# builds included), the things an administrator needs to reach the host, and
# database servers.
protected_unit() {
    case "$1" in
        nginx.service | init.scope | user@*.service | session-*.scope) return 0 ;;
        docker.* | docker-*.scope | containerd.* | podman* | libpod-* | crio.* | lxd* | incus*) return 0 ;;
        snap.docker.* | snap.lxd.* | snap.microk8s.* | snap.k8s.* | snap.incus.*) return 0 ;;
        ssh.* | sshd.* | systemd-* | dbus.* | NetworkManager* | cockpit*) return 0 ;;
        carlos-emr*) return 0 ;;
        mariadb.* | mysql.* | mysqld.* | postgresql* | redis* | mongod*) return 0 ;;
    esac
    return 1
}

# A process started by hand: a login session (ssh, a console), a desktop
# user's own service manager, or an application scope it started (a terminal
# in a graphical session).
hand_started_unit() {
    case "$1" in
        session-*.scope | user@*.service | app-*.scope) return 0 ;;
    esac
    return 1
}

# May this package configure stop unit $1? The same question deb-systemd-invoke
# asks /usr/sbin/policy-rc.d before it touches a service: 101 (forbidden) and
# 106 (not allowed, use a fallback) mean no; anything else, or no policy-rc.d
# at all, means yes.
policy_allows_stop() {
    command -v policy-rc.d >/dev/null 2>&1 || return 0
    policy-rc.d "${1%.*}" stop >/dev/null 2>&1
    case $? in
        101 | 106) return 1 ;;
    esac
    return 0
}

# The snap application behind unit $1 (snap.nextcloud.apache.service ->
# nextcloud.apache), or nothing for a unit snapd does not manage.
snap_app() {
    case "$1" in
        snap.*.service) ;;
        *) return 1 ;;
    esac
    app="${1#snap.}"
    printf '%s\n' "${app%.service}"
}

# Where unit $1 comes from, for the operator: "package apache2", or its unit
# file when no package ships it.
origin_of() {
    if pkg="$(package_of "$1")"; then
        printf 'package %s\n' "${pkg}"
        return
    fi
    file="$(systemctl show --property=FragmentPath --value "$1" 2>/dev/null)"
    printf 'unit file %s\n' "${file:-unknown}"
}

# Stop a single approved unit and keep it off. Prints
# how it was kept off: "disabled", or "masked" for a unit that cannot be
# disabled (static, generated, or pulled in by another unit), which would
# otherwise start again at the next boot and race nginx for the port.
stop_unit() {
    stop_status=0
    systemctl stop "$1" >/dev/null 2>&1 || stop_status=$?
    case "$1" in
        *.socket)
            # Check the state even if systemctl reports a failed stop.
            socket_is_down "$1" || return 1 ;;
        *) [ "${stop_status}" = 0 ] || return 1 ;;
    esac
    # `disable` follows Also=, including in drop-ins. `cat` reads the loaded
    # fragment and drop-in paths, so use it only when systemd has seen the
    # current configuration. A mask affects only the explicitly named unit.
    if reload="$(systemctl show --property=NeedDaemonReload --value "$1" 2>/dev/null)" &&
            [ "${reload}" = no ] && fragments="$(systemctl cat --no-pager "$1" 2>/dev/null)" &&
            ! printf '%s\n' "${fragments}" | grep -Eq '^[[:space:]]*Also([[:space:]]|=|\\|$)'; then
        systemctl disable "$1" >/dev/null 2>&1 || true
    fi
    case "$(systemctl is-enabled "$1" 2>/dev/null)" in
        disabled) say disabled ;;
        masked) say masked ;;
        *)
            if systemctl mask "$1" >/dev/null 2>&1; then
                say masked
            else
                say enabled
            fi ;;
    esac
}

# Advice for a listener left in place: $1 name, $2 unit (may be empty).
advice() {
    if hand_started_unit "$2"; then
        say "it was started by hand, not by a system service; stop that program"
        return
    fi
    case "$1|$2" in
        docker-proxy\|* | *\|docker.service | *\|containerd.service | *\|docker-*.scope)
            say "a Docker container publishes this port ('sudo docker ps' shows which); stop it or publish it on another port" ;;
        conmon\|* | rootlessport*\|* | pasta*\|* | slirp4netns\|* | *\|libpod-* | *\|podman*)
            say "a Podman container publishes this port ('sudo podman ps' shows which); stop it or publish it on another port" ;;
        *\|*.scope)
            say "it runs in ${2}, not in a system service; stop that program" ;;
        *)
            if [ -n "$2" ] && protected_unit "$2"; then
                say "the installer never stops ${2}; move it to other ports"
            elif [ -n "$2" ]; then
                say "stop it or move it to other ports: sudo systemctl disable --now $2"
            else
                say "stop that program or move it to other ports"
            fi ;;
    esac
}

describe() {  # $1 name, $2 pid, $3 unit (may be empty), $4 addresses
    if [ "$1" = "-" ]; then
        printf 'a listener whose owner ss cannot show is on %s' "$4"
    elif [ -n "$3" ]; then
        printf '%s (pid %s, %s) is listening on %s' "$1" "$2" "$3" "$4"
    else
        printf '%s (pid %s) is listening on %s' "$1" "$2" "$4"
    fi
}

# Every listener on ports $2.. that collides with bind IP $1 and is not
# nginx.service's own, as "ADDRESS NAME PID UNIT" (UNIT "-" when unknown).
colliding() {
    bind_ip="$1"
    shift
    for port in "$@"; do
        rows="$(listeners "${port}")" || return 2
        [ -n "${rows}" ] || continue
        while read -r addr name pid; do
            collides "$(host_of "${addr}")" "${bind_ip}" || continue
            unit='-'
            if [ "${pid}" != "-" ]; then
                if [ "${pid}" = 1 ]; then
                    unit="$(socket_unit_for "${addr}")"
                    [ -n "${unit}" ] || unit='-'
                else
                    unit="$(unit_of "${pid}")" || unit='-'
                fi
            fi
            # nginx.service's own sockets are the point, not a conflict. An
            # nginx whose unit cannot be told is given the benefit of the doubt.
            [ "${unit}" = nginx.service ] && continue
            [ "${unit}" = "-" ] && [ "${name}" = nginx ] && continue
            printf '%s %s %s %s\n' "${addr}" "${name}" "${pid}" "${unit}"
        done <<EOF
${rows}
EOF
    done
}

# Group colliding rows by owner so one apache2 on four addresses is one line:
# "NAME PID UNIT ADDR, ADDR".
grouped() {
    awk '
        { key = $2 SUBSEP $4; if (!(key in first)) { order[++n] = key; first[key] = $3 SUBSEP $2 SUBSEP $4; addrs[key] = $1 }
          else if (index(", " addrs[key] ", ", ", " $1 ", ") == 0) addrs[key] = addrs[key] ", " $1 }
        END { for (i = 1; i <= n; i++) { split(first[order[i]], f, SUBSEP); print f[2], f[1], f[3], addrs[order[i]] } }'
}

# The read-only plan shows candidates before approval has been given.
approved_unit() {
    [ "${mode}" = stop ] || return 0
    case "${approved}" in *" $1 "*) return 0 ;; esac
    return 1
}

socket_is_down() {
    state="$(systemctl show --property=ActiveState --value "$1" 2>/dev/null)" || return 1
    case "${state}" in inactive | failed) return 0 ;; esac
    return 1
}

# Look up a unit's reason in the stop plan. Unit names may contain literal
# systemd backslash escapes.
blocker_for() {
    while read -r blocked_unit blocked_reason; do
        if [ "${blocked_unit}" = "$1" ]; then
            say "${blocked_reason}"
            return
        fi
    done <<REASONS
${blockers}
REASONS
}

remember_blocker() {
    blockers="${blockers}
$1 $2"
}

# Test the same stop rules in the plan and the fresh scan. Each systemd stop
# is deliberately scoped to one unit. A reverse Requires=, Requisite=,
# BindsTo= or PartOf=, or a PropagatesStopTo=, would widen that transaction.
stop_blocker() {
    if protected_unit "$1"; then
        say "is protected from automatic stops"
    elif ! policy_allows_stop "$1"; then
        say "was left running because policy-rc.d forbids stopping services during this install"
    elif ! approved_unit "$1"; then
        say "was not among the services approved for stopping (it took the port, or changed, after the list was shown), so it was left running"
    elif ! dependents="$(systemctl show --property=RequiredBy --property=RequisiteOf \
             --property=BoundBy --property=ConsistsOf --property=PropagatesStopTo \
             --value "$1" 2>/dev/null)"; then
        say "was left running because its systemd stop dependencies could not be determined"
    else
        # The properties are whitespace-separated lists. Keep the reason on
        # one line even when more than one property contributes units.
        for dependent in ${dependents}; do
            [ "${dependent}" = "$1" ] && continue
            say "was left running because stopping it would also stop ${dependent}. Resolve the linked units manually"
            return
        done
    fi
}

# Known triggers by socket, observed using the same scan that found the
# listeners. A failed lookup is recorded separately from an empty result.
triggers_for() {
    while read -r socket_name socket_triggers; do
        if [ "${socket_name}" = "$1" ]; then
            say "${socket_triggers}"
            return
        fi
    done <<SOCKETS
${socket_graph}
SOCKETS
}

# When a socket's forward query fails, check the service's reverse link.
# If neither side can be checked, the service cannot safely be stopped.
has_unknown_activator() {
    [ "${unknown_sockets}" != " " ] || return 1
    activators="$(systemctl show --property=TriggeredBy --value "$1" 2>/dev/null)" || return 0
    for activator in ${activators}; do
        case "${unknown_sockets}" in *" ${activator} "*) return 0 ;; esac
    done
    return 1
}

hold_triggers() {
    for trigger in "$@"; do
        held="${held}${trigger} "
    done
}

service_blocker() {
    case "${held}" in
        *" $1 "*) say "was left running because the socket that starts it is left running"; return ;;
    esac
    if has_unknown_activator "$1"; then
        say "was left running because a colliding socket may still start it"
    else
        stop_blocker "$1"
    fi
}

socket_blocker() {
    reason="$(stop_blocker "$1")"
    if [ -n "${reason}" ]; then
        say "${reason}"
        return
    fi
    shift
    for service in "$@"; do
        reason="$(service_blocker "${service}")"
        if [ -n "${reason}" ]; then
            say "starts ${service}, which ${reason}"
            return
        fi
    done
}

# Mark all ineligible sockets before taking any action. If two sockets
# share a trigger, keeping one also keeps the other and its triggers.
prepare_sockets() {
    for socket in "$@"; do
        if triggers="$(systemctl show --property=Triggers --value "${socket}" 2>/dev/null)"; then
            # Normalize whitespace before writing a single record.
            normalized=""
            for service in ${triggers}; do
                normalized="${normalized} ${service}"
            done
            socket_graph="${socket_graph}
${socket}${normalized}"
        else
            unknown_sockets="${unknown_sockets}${socket} "
            remember_blocker "${socket}" "was left running because its socket triggers could not be determined"
        fi
    done

    changed=1
    while [ "${changed}" = 1 ]; do
        changed=0
        for socket in "$@"; do
            [ -z "$(blocker_for "${socket}")" ] || continue
            triggers="$(triggers_for "${socket}")"
            # shellcheck disable=SC2086 # whitespace-separated unit names
            reason="$(socket_blocker "${socket}" ${triggers})"
            if [ -n "${reason}" ]; then
                remember_blocker "${socket}" "${reason}"
                # shellcheck disable=SC2086 # whitespace-separated unit names
                hold_triggers ${triggers}
                changed=1
            fi
        done
    done
}

plan_unit() {
    for planned_unit in "$@"; do
        case "${planned}" in *" ${planned_unit} "*) continue ;; esac
        planned="${planned}${planned_unit} "
        say "will-stop-unit: ${planned_unit}"
    done
}

# The first argument is an approved unit. The second describes its listener
# or how it belongs to a socket whose stop was confirmed.
stop_and_report() {
    label="$1 ($(origin_of "$1")) $2"
    if app="$(snap_app "$1")" && command -v snap >/dev/null 2>&1; then
        # snapd owns its units: systemctl disable would be undone by a refresh.
        snap stop --disable "${app}" >/dev/null 2>&1 || return 1
        say "stopped: the ${app%%.*} snap's ${app} service $2; it is stopped and disabled but still installed (to use it again, move it to other ports, then: sudo snap start --enable ${app})"
        return
    fi
    kept_off="$(stop_unit "$1")" || return 1
    case "${kept_off}" in
        disabled)
            say "stopped: ${label}; it is stopped and disabled but still installed (to use it again, move it to other ports, then: sudo systemctl enable --now $1)" ;;
        masked)
            say "stopped: ${label}; it is stopped and masked (to use it again, move it to other ports, then: sudo systemctl unmask $1 && sudo systemctl start $1)" ;;
        *)
            say "stopped: ${label}; it is stopped, but could not be disabled or masked and may take the port again at the next boot (keep it off: sudo systemctl mask $1)" ;;
    esac
}

handle_service() {
    case "${processed}" in *" $1 "*) return ;; esac
    processed="${processed}$1 "
    reason="$(service_blocker "$1")"
    if [ -n "${reason}" ]; then
        remember_blocker "$1" "${reason}"
    elif [ "${mode}" = plan ]; then
        case "${planned}" in *" $1 "*) return ;; esac
        if app="$(snap_app "$1")" && command -v snap >/dev/null 2>&1; then
            say "will-stop: the ${app%%.*} snap's ${app} service, on $2"
        else
            say "will-stop: $1 ($(origin_of "$1")), on $2"
        fi
        plan_unit "$1"
    elif stop_and_report "$1" "$2"; then
        acted=1
    else
        remember_blocker "$1" "could not be stopped"
    fi
}

front_door() {
    mode=legacy
    approved=" "
    case "${1:-}" in
        --plan) mode=plan; shift ;;
        --report) mode=report; shift ;;
        --approved)
            [ $# -ge 2 ] || usage
            mode=stop
            # Split on whitespace only (set -f above: never as a glob).
            for approved_name in $2; do
                approved="${approved}${approved_name} "
            done
            shift 2 ;;
    esac
    [ $# = 1 ] || usage
    bind_ip="$(printf '%s\n' "$1" | sed 's/^\[\(.*\)\]$/\1/')"
    found="$(colliding "${bind_ip}" 80 443)" || return 2
    [ -n "${found}" ] || return 0

    rows="$(printf '%s\n' "${found}" | grouped)"
    acted=0
    blockers=""
    planned=" "
    if [ "${mode}" = plan ] || [ "${mode}" = stop ]; then
        held=" "
        unknown_sockets=" "
        socket_graph=""
        stopped_sockets=""
        pending=""
        sockets="$(printf '%s\n' "${rows}" | awk '$3 ~ /\.socket$/ { print $3 }' | sort -u)"
        # shellcheck disable=SC2086 # whitespace-separated unit names
        prepare_sockets ${sockets}

        # Finish every socket attempt before stopping any service. One
        # failed socket must keep its triggers running even if an approved
        # socket earlier in the scan also started them.
        while read -r name pid unit addrs; do
            case "${unit}" in *.socket) ;; *) continue ;; esac
            [ -z "$(blocker_for "${unit}")" ] || continue
            triggers="$(triggers_for "${unit}")"
            if [ "${mode}" = plan ]; then
                if [ -n "${triggers}" ]; then
                    say "will-stop: ${unit} ($(origin_of "${unit}")) and the $(printf '%s' "${triggers}" | sed 's/ /, /g') it starts, on ${addrs}"
                else
                    say "will-stop: ${unit} ($(origin_of "${unit}")), on ${addrs}"
                fi
                # shellcheck disable=SC2086 # whitespace-separated unit names
                plan_unit "${unit}" ${triggers}
                continue
            fi
            # Query the current graph before the stop in case the socket was
            # reloaded during this scan. A changed set can invalidate the
            # sharing decisions already made for other sockets.
            if ! current_triggers="$(systemctl show --property=Triggers --value "${unit}" 2>/dev/null)"; then
                remember_blocker "${unit}" "was left running because its socket triggers could not be determined"
                unknown_sockets="${unknown_sockets}${unit} "
            elif [ "$(printf '%s' "${current_triggers}" | tr -s ' ')" != "${triggers}" ]; then
                remember_blocker "${unit}" "was left running because its socket triggers changed during the stop"
            else
                # shellcheck disable=SC2086 # whitespace-separated unit names
                reason="$(socket_blocker "${unit}" ${triggers})"
                if [ -n "${reason}" ]; then
                    remember_blocker "${unit}" "${reason}"
                elif stop_and_report "${unit}" "was listening on ${addrs}, which the CARLOS front door needs"; then
                    stopped_sockets="${stopped_sockets} ${unit}"
                    acted=1
                    continue
                else
                    remember_blocker "${unit}" "could not be stopped"
                fi
            fi
            # Hold both observed sets if the socket's state is uncertain.
            # shellcheck disable=SC2086 # whitespace-separated unit names
            hold_triggers ${triggers} ${current_triggers}
        done <<ROWS
${rows}
ROWS

        # Recheck sockets after enablement changes and the other stop jobs.
        for socket in ${stopped_sockets}; do
            triggers="$(triggers_for "${socket}")"
            if socket_is_down "${socket}"; then
                pending="${pending} ${triggers}"
            else
                remember_blocker "${socket}" "was active again after its stop"
                # shellcheck disable=SC2086 # whitespace-separated unit names
                hold_triggers ${triggers}
            fi
        done

        processed=" "
        while read -r name pid unit addrs; do
            case "${unit}" in *.service) ;; *) continue ;; esac
            if [ "${mode}" = plan ]; then
                handle_service "${unit}" "${addrs}"
            else
                handle_service "${unit}" "was listening on ${addrs}, which the CARLOS front door needs"
            fi
        done <<ROWS
${rows}
ROWS
        for service in ${pending}; do
            handle_service "${service}" "was started by a socket on a CARLOS front-door port"
        done
    fi

    if [ "${acted}" = 1 ]; then
        # A stopped server releases its sockets a moment later.
        i=0
        while [ "$i" -lt 50 ]; do
            found="$(colliding "${bind_ip}" 80 443)" || return 2
            [ -n "${found}" ] || return 0
            sleep 0.2
            i=$((i + 1))
        done
        rows="$(printf '%s\n' "${found}" | grouped)"
    fi

    while read -r name pid unit addrs; do
        if [ "${mode}" = plan ]; then
            case "${planned}" in *" ${unit} "*) continue ;; esac
        fi
        [ "${unit}" != "-" ] || unit=""
        reason="$(blocker_for "${unit}")"
        if [ "${mode}" = legacy ]; then
            reason="the caller provided no approved unit list. Use 'sudo dpkg-reconfigure carlos-emr' to review this conflict; "
        elif [ -n "${reason}" ]; then
            reason="it ${reason}; "
        fi
        say "blocked: $(describe "${name}" "${pid}" "${unit}" "${addrs}"), so nginx cannot serve the CARLOS front door; ${reason}$(advice "${name}" "${unit}")"
    done <<ROWS
${rows}
ROWS
    return 1
}

mariadb_cause() {
    state=""
    if command -v systemctl >/dev/null 2>&1; then
        state="$(systemctl is-active mariadb.service 2>/dev/null)" || true
    fi
    case "${state}" in
        failed | inactive | deactivating)
            holders="$(colliding 127.0.0.1 3306 2>/dev/null | awk '$4 != "mariadb.service"' | grouped)" || holders=""
            if [ -n "${holders}" ]; then
                printf '%s\n' "${holders}" | {
                    read -r name pid unit addrs
                    [ "${unit}" != "-" ] || unit=""
                    say "cause: mariadb.service is ${state} because port 3306 is taken: $(describe "${name}" "${pid}" "${unit}" "${addrs}"); $(advice "${name}" "${unit}")"
                }
                return 0
            fi
            # The last ERROR is normally just "Aborting". Keep the useful
            # cause a few lines above it: a failed first initialization after
            # a purge/reinstall left no mysql privilege tables.
            last="$(journalctl -u mariadb.service -b --no-pager -o cat -n 300 2>/dev/null |
                grep -F '[ERROR]' | grep -vE '\[ERROR\] Aborting[[:space:]]*$' |
                tail -n 1 | sed 's/^[0-9-]* *[0-9:]* *[0-9]* *//' | cut -c1-200)"
            if printf '%s\n' "${last}" | grep -E "mysql\.(db|servers|global_priv|user).*doesn't exist" >/dev/null; then
                say "cause: mariadb.service is ${state}: MariaDB's mysql system tables are missing; see 'Missing MariaDB system tables' in /usr/share/doc/carlos-emr/README.Debian. On a new site, reconfigure carlos-emr to retry initialization; on an existing site, check the data volume mount and recover the database from backup"
                return 0
            fi
            say "cause: mariadb.service is ${state}${last:+" (its last error: ${last})"}; see: sudo journalctl -u mariadb -n 50"
            return 0 ;;
        activating)
            say "cause: mariadb.service was still starting; when 'systemctl is-active mariadb' says active, finish the install"
            return 0 ;;
    esac
    if ! command -v mariadb >/dev/null 2>&1; then
        say "cause: the mariadb client is not installed (sudo apt install mariadb-client)"
        return 0
    fi
    err="$(timeout 10 mariadb --protocol=socket --user=root --connect-timeout=5 -e 'SELECT 1' 2>&1 >/dev/null)"
    rc=$?
    first="$(printf '%s\n' "${err}" | awk 'NF { print; exit }' | cut -c1-200)"
    if [ "${rc}" = 0 ]; then
        say "cause: MariaDB answers root over the unix socket now; it was not ready while the package was configured"
    elif [ "${rc}" = 124 ]; then
        say "cause: MariaDB did not answer root within 10 seconds (still recovering, or overloaded); see: sudo journalctl -u mariadb -n 50"
    else
        case "${err}" in
            *"account is locked"*)
                # A locked root cannot log in to unlock itself, by password or
                # by socket: only the grant-table reset recovers it.
                say "cause: MariaDB is running, but its root@localhost account is locked (${first}), and a locked root cannot log in to unlock itself; reset it as described under 'MariaDB root access' in /usr/share/doc/carlos-emr/README.Debian (a restart with --skip-grant-tables)" ;;
            *ERROR\ 1045*using\ password:\ NO*)
                # 1045 without a password offered: the account wants one. The
                # unix_socket plugin, which is how CARLOS administers MariaDB,
                # would have let the system root user in.
                say "cause: MariaDB is running, but its root@localhost account was given a password before CARLOS was installed and refuses the system root user over the unix socket, which is how CARLOS administers the database; put root back to the distribution default (socket login, no root password) as described under 'MariaDB root access' in /usr/share/doc/carlos-emr/README.Debian" ;;
            *ERROR\ 1045*using\ password:\ YES*)
                # A password was sent although CARLOS passes none: a client
                # option file (/root/.my.cnf, or a [client] section under
                # /etc/mysql) supplies one, and root has no socket login to
                # fall back on. Adding socket login fixes it; the option file
                # then no longer matters.
                say "cause: MariaDB is running, but root@localhost has no unix-socket login, and a MariaDB client option file (/root/.my.cnf, or a [client] section under /etc/mysql) sends a password it refuses (${first}); put root back to the distribution default (socket login, no root password) and delete that stored password, as described under 'MariaDB root access' in /usr/share/doc/carlos-emr/README.Debian" ;;
            *"Access denied"*)
                say "cause: MariaDB is running but refuses the system root user over the unix socket (${first}); CARLOS administers the database as root@localhost through unix_socket, see 'MariaDB root access' in /usr/share/doc/carlos-emr/README.Debian" ;;
            *"ERROR 2002"* | *"Can't connect to local server through socket"*)
                holders="$(colliding 127.0.0.1 3306 2>/dev/null | awk '$4 != "mariadb.service"' | grouped)" || holders=""
                if [ -n "${holders}" ]; then
                    printf '%s\n' "${holders}" | {
                        read -r name pid unit addrs
                        [ "${unit}" != "-" ] || unit=""
                        say "cause: MariaDB is not answering on its unix socket, and port 3306 is taken: $(describe "${name}" "${pid}" "${unit}" "${addrs}"); $(advice "${name}" "${unit}")"
                    }
                else
                    say "cause: MariaDB is not answering on its unix socket (${first:-"ERROR 2002"}); check 'systemctl status mariadb' and any 'socket =' setting under /etc/mysql"
                fi ;;
            *)
                say "cause: MariaDB refused root: ${first:-"exit status ${rc}"}" ;;
        esac
    fi
    return 0
}

case "${1:-}" in
    front-door)
        shift
        front_door "$@"
        exit $? ;;
    mariadb)
        [ $# = 1 ] || usage
        mariadb_cause
        exit $? ;;
    *)
        usage ;;
esac
