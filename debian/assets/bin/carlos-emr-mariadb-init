"""Finish a failed first MariaDB initialization without resetting existing data.

The distribution's postinst deliberately ignores mariadb-install-db failures.
A later service start can then leave only engine/log files in the datadir and
abort because mysql.db is absent. Retry initialization only in that narrow case.
Never remove files, initialize a populated/damaged database, or stop a server.
Exit 0 only after initialization, 2 when no initialization was needed, and 1
when initialization was refused or failed. Only 0 permits a service restart.
"""

import argparse
import fcntl
import os
from pathlib import Path
import pwd as system_accounts
import re
import shlex
import subprocess
import sys
import tempfile


STATE = Path("/var/lib/carlos-emr")
RUNTIME = Path("/run")
IMPORT_GUARD = "/usr/lib/carlos-emr/carlos-emr-o19-guard"
PROPERTIES = Path("/etc/carlos-emr/carlos.properties")
SKEL = Path("/usr/share/carlos-emr/skel/carlos.properties")
WSREP_ENV_FILES = frozenset(("/run/mysqld/wsrep-new-cluster", "/run/mysqld/wsrep-start-position"))
OPTION_ENV = frozenset(("MYSQLD_OPTS", "_WSREP_NEW_CLUSTER", "_WSREP_START_POSITION",
                        "MYSQL_HOME", "MARIADB_HOME", "MYSQL_GROUP_SUFFIX", "MARIADB_GROUP_SUFFIX"))
SERVICE_PROPERTIES = ("ExecStart", "ExecStartEx", "User", "Group", "ProtectHome", "SetLoginEnvironment",
                      "Environment", "EnvironmentFiles", "PassEnvironment", "UnsetEnvironment",
                      "RootDirectory", "RootImage", "WorkingDirectory", "BindPaths",
                      "BindReadOnlyPaths", "TemporaryFileSystem", "PAMName", "PrivateTmp",
                      "PrivateUsers", "DynamicUser", "InaccessiblePaths", "MountImages",
                      "ExtensionImages", "ExtensionDirectories")
COMMAND_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}
# Files a failed first start can leave before any database has been created.
# Upgrade-info markers are deliberately absent: they identify an existing
# installation whose missing system schema needs recovery, not initialization.
# Older distribution postinsts touch debian-<version>.flag BEFORE initializing.
STARTUP_FILE = re.compile(
    r"(?:aria_log\.[0-9]+|aria_log_control|ib_buffer_pool|ibdata1|"
    r"ib_logfile[0-9]+|ibtmp1|undo[0-9]+|ddl_recovery(?:-backup)?\.log|"
    r"multi-master\.info|tc\.log|debian-[0-9.]+\.flag|"
    r"binlog\.(?:[0-9]+(?:\.idx)?|index|state))\Z"
)


def say(message):
    print("carlos-emr: " + message, file=sys.stderr)


def run(args, timeout=30, env=None, cwd=None):
    return subprocess.run(args, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, timeout=timeout, env=env, cwd=cwd, check=False)


def hidden_by_protect_home(path):
    resolved = path.resolve()
    return any(resolved.is_relative_to(base) for base in (Path("/root"), Path("/home"), Path("/run/user")))


def service_context():
    """Prove that the mysql-user probe uses the stopped service's option context.

    Do not try to interpret arbitrary ExecStart overrides as a shell command.
    Unsupported service options need operator recovery, never a guessed datadir.
    """
    result = run(["systemctl", "show", "mariadb.service",
                  "--property=" + ",".join(SERVICE_PROPERTIES)])
    properties = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    if result.returncode or not all(key in properties for key in SERVICE_PROPERTIES):
        return None
    if properties["User"] != "mysql" or properties["Group"] != "mysql":
        return None
    if properties["ProtectHome"] not in ("yes", "true") or properties["SetLoginEnvironment"] not in ("yes", "true"):
        return None
    if properties["WorkingDirectory"] not in ("", "/"):
        return None
    if any(properties[key] not in ("no", "false") for key in ("PrivateTmp", "PrivateUsers", "DynamicUser")):
        return None
    if any(properties[key] for key in ("RootDirectory", "RootImage", "BindPaths", "BindReadOnlyPaths",
                                       "TemporaryFileSystem", "PAMName", "PassEnvironment", "UnsetEnvironment",
                                       "InaccessiblePaths", "MountImages", "ExtensionImages", "ExtensionDirectories")):
        return None
    executable = "/usr/sbin/mariadbd"
    command = properties["ExecStart"]
    argv = re.findall(r"argv\[\]=(.*?)\s*;", command)
    if re.findall(r"\bpath=([^ ;]+)", command) != [executable] or len(argv) != 1:
        return None
    if shlex.split(argv[0]) != [executable, "$MYSQLD_OPTS", "$_WSREP_NEW_CLUSTER", "$_WSREP_START_POSITION"]:
        return None
    # Legacy ExecStart hides '+'/'!' prefixes that change execution identity.
    # The extended form must describe this same command without special flags.
    extended = properties["ExecStartEx"]
    extended_argv = re.findall(r"argv\[\]=(.*?)\s*;", extended)
    if (re.findall(r"\bpath=([^ ;]+)", extended) != [executable]
            or len(extended_argv) != 1 or shlex.split(extended_argv[0]) != shlex.split(argv[0])
            or re.findall(r"\bflags=(.*?)\s*;", extended) != [""]):
        return None
    # Unit settings and manager variables are captured, never printed: either
    # may contain credentials. Only empty MariaDB option settings are supported.
    for setting in shlex.split(properties["Environment"]):
        name, sep, value = setting.partition("=")
        if not sep or name not in OPTION_ENV or value:
            return None
    manager = run(["systemctl", "show-environment"])
    if manager.returncode:
        return None
    for setting in manager.stdout.splitlines():
        name, _, value = setting.partition("=")
        if name in OPTION_ENV and value:
            return None
    files = properties["EnvironmentFiles"]
    entries = re.findall(r"(\S+) \(ignore_errors=(yes|no)\)", files)
    if re.sub(r"\S+ \(ignore_errors=(?:yes|no)\)", "", files).strip():
        return None
    for name, optional in entries:
        if name not in WSREP_ENV_FILES or optional != "yes":
            return None
        path = Path(name)
        if path.is_symlink():
            return None
        if not path.exists():
            continue
        if not path.is_file() or path.stat().st_size > 4096:
            return None
        for line in path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith(("#", ";")):
                continue
            variable, sep, value = line.partition("=")
            if (not sep or variable not in ("_WSREP_NEW_CLUSTER", "_WSREP_START_POSITION")
                    or value.strip() not in ("", "''", '\"\"')):
                return None
    try:
        home = Path(system_accounts.getpwnam("mysql").pw_dir)
    except KeyError:
        return None
    if not home.is_absolute() or hidden_by_protect_home(home):
        return None
    # Clear the caller's environment AFTER runuser's PAM processing as well.
    # Root's ~/.my.cnf and MYSQL_HOME must affect neither probe nor bootstrap.
    return ["runuser", "-u", "mysql", "-g", "mysql", "--", "env", "-i",
            "PATH=" + COMMAND_ENV["PATH"], "HOME=" + str(home), "USER=mysql", "LOGNAME=mysql",
            "LC_ALL=C", "TMPDIR="]


def untouched_site():
    """An empty mountpoint is not evidence that an established site is new."""
    if any(path.is_symlink() or not path.is_file() for path in (PROPERTIES, SKEL)):
        return False
    return PROPERTIES.read_bytes() == SKEL.read_bytes()


def empty_document_store():
    """Even an explicitly new database must not inherit old patient documents."""
    documents = STATE / "CarlosDocument"
    if documents.is_symlink():
        return False
    if documents.exists():
        if not documents.is_dir():
            return False
        def fail_scan(error):
            raise error
        # rglob suppresses PermissionError, including on root-squashed NFS.
        # Unreadable retained data must not masquerade as an empty new site.
        for parent, directories, files in os.walk(documents, followlinks=False, onerror=fail_scan):
            if files or any((Path(parent) / name).is_symlink() for name in directories):
                return False
    return True


def initialize(accept_empty_datadir=False):
    if os.geteuid() != 0:
        say("MariaDB initialization requires root.")
        return 1

    # Use the same lock and paused-import guard as both package postinsts and
    # finish-install. Taking it here must not block the install's own later
    # acquisition: the descriptor closes before this helper returns.
    STATE.mkdir(parents=True, exist_ok=True)
    fd = os.open(STATE / ".finish-install.lock",
                 os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "r+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            say("MariaDB initialization deferred: another provisioning run holds the database lock.")
            return 1
        if not os.path.isfile(IMPORT_GUARD) or not os.access(IMPORT_GUARD, os.X_OK):
            say("MariaDB initialization deferred: the import guard is missing or not executable; repair the package first.")
            return 1
        if run([IMPORT_GUARD]).returncode != 0:
            say("MariaDB initialization deferred: an OSCAR 19 import owns the database.")
            return 1

        service = run(["systemctl", "is-active", "mariadb.service"])
        if service.stdout.strip() not in ("failed", "inactive"):
            return 2
        # is-active cannot see a mariadbd started by hand. Refuse that too,
        # even when systemd considers its own service stopped.
        for name in ("mariadbd", "mysqld"):
            probe = run(["pgrep", "-x", name])
            if probe.returncode != 1:
                say("MariaDB initialization deferred: a database process is running or could not be checked.")
                return 1

        context = service_context()
        if context is None:
            say("MariaDB service options or environment differ from the supported mysql-user context; "
                "refusing to guess its data directory. See README.Debian for manual recovery.")
            return 1

        # Read the server's effective configuration, including its compiled
        # default. Ubuntu 26.04 uses /var/lib/mariadb, older systems commonly
        # use /var/lib/mysql, and an operator may have moved either one.
        help_result = run(context + ["mariadbd", "--verbose", "--help"], env=COMMAND_ENV, cwd="/")
        match = re.search(r"^datadir[ \t]+(.+?)[ \t]*$", help_result.stdout, re.MULTILINE)
        if help_result.returncode != 0 or match is None:
            say("Could not determine MariaDB's configured data directory; leaving it unchanged.")
            return 1
        datadir = Path(match.group(1))
        # The vendor's shell initializer splits datadir internally even when
        # we pass it as one argv entry. Do not attempt a path it cannot handle.
        if re.search(r"\s", str(datadir)):
            say("MariaDB's data directory contains whitespace unsupported by mariadb-install-db; "
                "leaving it unchanged for manual recovery.")
            return 1
        if not datadir.is_absolute() or not datadir.is_dir() or hidden_by_protect_home(datadir):
            say("MariaDB's configured data directory is absent or invalid; leaving it unchanged.")
            return 1
        if (datadir / "mysql").exists():
            if not (datadir / "mysql" / "db.frm").is_file():
                say("MariaDB's existing mysql system schema is incomplete; refusing to reinitialize it. "
                    "See 'Missing MariaDB system tables' in README.Debian.")
                return 1
            return 2
        for entry in datadir.iterdir():
            if (entry.name in ("lost+found", "#binlog_cache_files") and not entry.is_symlink()
                    and entry.is_dir() and not any(entry.iterdir())):
                continue
            if entry.is_symlink() or not entry.is_file() or not STARTUP_FILE.fullmatch(entry.name):
                say(f"MariaDB's mysql system schema is missing in {datadir}, but existing data is present. "
                    "Refusing to initialize it; restore the system schema from a matching backup "
                    "(see 'Missing MariaDB system tables' in README.Debian).")
                return 1

        if not empty_document_store():
            say("Retained clinical documents cannot be paired with a new empty database. Restore a matching "
                "database and document backup, or verify and archive the complete old document store outside "
                "the active CarlosDocument path before retrying. See README.Debian.")
            return 1
        if not accept_empty_datadir and not untouched_site():
            say("MariaDB's mysql schema is missing, but this site's configuration "
                "does not prove an unfinished first initialization. Check that the database volume is mounted "
                "and recover the existing database. Only for an intentionally new database, rerun with "
                "--accept-empty-datadir (see README.Debian).")
            return 1

        # CARLOS configures a named default timezone. Empty vendor timezone
        # tables would let bootstrap finish but make the normal service abort
        # with "Illegal or unknown default time zone". Prepare the system's
        # timezone SQL before writing any database files, and load it in the
        # same bootstrap that creates the new mysql schema.
        zones = run(context + ["mariadb-tzinfo-to-sql", "--no-defaults", "--skip-write-binlog",
                               "/usr/share/zoneinfo"],
                    timeout=60, env=COMMAND_ENV, cwd="/")
        if zones.returncode != 0 or not zones.stdout.strip():
            say("Could not prepare MariaDB timezone tables; leaving the data directory unchanged.")
            print(zones.stderr, file=sys.stderr, end="")
            return 1
        # The SQL contains only public timezone data. Keep it root-owned and
        # non-writable by mysql, but readable by the mysql-user initializer.
        # A private, exclusive temporary file avoids following existing paths.
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=RUNTIME,
                                         prefix="carlos-emr-mariadb-tz-", suffix=".sql") as sql:
            sql.write("USE mysql;\n" + zones.stdout)
            sql.flush()
            os.fchmod(sql.fileno(), 0o644)
            say(f"Initializing missing MariaDB system tables in {datadir}; existing files are retained.")
            # timeout also terminates the initializer's bootstrap-server children.
            # Match the distribution's workaround for libpam-tmpdir (#1022994).
            result = run(["timeout", "--kill-after=10", "180"] + context + ["mariadb-install-db",
                          f"--datadir={datadir}", "--user=mysql",
                          "--auth-root-authentication-method=socket", "--skip-test-db",
                          "--disable-log-bin", "--default-time-zone=SYSTEM",
                          "--extra-file=" + sql.name], timeout=200,
                         env=COMMAND_ENV, cwd="/")
        if result.returncode != 0 or not (datadir / "mysql" / "db.frm").is_file():
            say("MariaDB system-table initialization failed; no files were removed. "
                "See the initializer output below and README.Debian.")
            print(result.stdout + result.stderr, file=sys.stderr, end="")
            return 1
        say("MariaDB system tables initialized; retrying the service start.")
        return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--accept-empty-datadir", action="store_true",
                        help="accept new database configuration after checking mounts/backups; never bypasses document or datadir checks")
    options = parser.parse_args([] if argv is None else argv)
    try:
        return initialize(options.accept_empty_datadir)
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        say(f"MariaDB initialization could not finish: {exc}. No files were removed.")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
