#!/bin/sh
# carlos-emr-o19-guard — may carlos-emr start right now?
#
# Exit 0: no OSCAR 19 import is in progress; the application may start.
# Exit 1: an import is in progress; the application MUST NOT start, because
#         its startup listener writes rows (program, site, memberships) into
#         a half-copied schema -- rows the import's row-parity gate then
#         rejects -- and a live session could read a half-copied chart.
#
# ONE predicate, three callers, so they cannot drift apart:
#   * carlos-emr.service consults it as ExecCondition= on EVERY start: a
#     reboot mid-import (seen on the Ubuntu 26.04 rehearsal, twice), a
#     `systemctl start` by a colleague who did not know, an unattended
#     upgrade's restart. `carlos-ctl stop` is `systemctl stop`: the unit
#     stays enabled, so without this a reboot starts the EMR into the
#     half-copied schema as if nothing were happening.
#   * carlos-emr.postinst (configure, and the abort-* restart) calls it
#     through o19_import_in_progress().
#   * scripts/migration/o19/platform-check/check.sh runs this file over the
#     full ledger matrix -- the shipped script, not a copy of it.
#
# The ledger is /var/lib/carlos-emr/o19-import/state.json, written by
# `carlos-ctl import-o19`. An import is in progress when the ledger exists,
# records phases beyond a staged assessment (`stage` alone is a dry run or
# an abandoned preflight and holds nothing back), and P7 `verify` has not
# completed. Fails CLOSED: a ledger that exists but cannot be read counts as
# in progress -- the wrong remedy for that is a restore, not a start.
#
# Usage: carlos-emr-o19-guard [LEDGER]
#   LEDGER defaults to the real path. The argument exists for the platform
#   check, which points it at a scratch file; the unit and the postinst
#   pass nothing. No environment variable is consulted.
#
# Keep this file `dash -n`-clean and free of bashisms: the unit runs it
# through /bin/sh, and the platform check parses it under dash.

LEDGER="${1:-/var/lib/carlos-emr/o19-import/state.json}"

# No ledger, or an empty one: nothing is in progress.
[ -s "$LEDGER" ] || exit 0

# python3 exits 0 when the ledger describes a FINISHED import or a mere
# assessment, 1 when it describes one in progress (or cannot be read).
if python3 -c 'import json, sys
try:
    s = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
if not isinstance(s, dict):
    sys.exit(1)
p = s.get("phases")
if not isinstance(p, dict):
    sys.exit(1)
if p and not (set(p) - set(["stage"])):
    sys.exit(0)
v = p.get("verify")
sys.exit(0 if isinstance(v, dict) and v.get("status") == "done" else 1)
' "$LEDGER"; then
    exit 0
fi

echo "carlos-emr: NOT starting: an OSCAR 19 import is in progress (ledger $LEDGER)." >&2
echo "carlos-emr: Started now, the EMR would write into a half-copied schema. Finish the" >&2
echo "carlos-emr: import with: sudo carlos-ctl import-o19 ... --resume" >&2
echo "carlos-emr: (a dry run or abandoned assessment: sudo carlos-ctl import-o19 --cleanup)," >&2
echo "carlos-emr: then start carlos-emr." >&2
exit 1
