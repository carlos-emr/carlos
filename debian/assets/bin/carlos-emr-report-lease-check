"""Run the read-only configure check with the packaged service's configuration paths."""

import os
import shlex
import subprocess
import sys


def main(env_file, java, classpath, classes, managed):
    # Read the same operator-owned environment file as carlos-emr-tomcat, as
    # carlos. Do not inherit the package installer's JVM options or run a site's
    # Java agents, profilers or heap settings in the diagnostic JVM.
    environment = {"HOME": os.environ["HOME"], "PATH": "/usr/bin:/bin"}
    read_options = subprocess.run(
        ["/bin/bash", "-euc", """
            CONF_DIR=/etc/carlos-emr
            PROPERTIES=$2
            CATALINA_HOME=/usr/share/tomcat11
            CATALINA_BASE=/var/lib/carlos-emr/catalina
            . "$1" >/dev/null
            printf '%s\\0' "${CARLOS_JAVA_OPTS:-}" "${JAVA_OPTS:-}" "${JAVA_TOOL_OPTIONS:-}" \
                "${JDK_JAVA_OPTIONS:-}" "${_JAVA_OPTIONS:-}"
        """, "report-lease-check", env_file, managed],
        env=environment, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=True,
    )
    site, java_opts, tool_opts, jdk_opts, last_opts, end = os.fsdecode(read_options.stdout).split("\0")
    if end or tool_opts or jdk_opts or last_opts:
        # JVM-wide injection uses distinct quoting and precedence rules.
        return 1
    os.chdir("/var/lib/carlos-emr/catalina")  # Tomcat resolves relative paths here.
    selected = managed
    home_args = []
    # Catalina puts JAVA_OPTS first, then the packaged override, then site flags.
    for options in (java_opts, shlex.quote("-Dcarlos_override_properties=" + managed), site):
        if any(char in options for char in "$`*?[]{}~#;&|<>()\n"):
            return 1  # Shell expansion cannot be inspected as a literal argument.
        for option in shlex.split(options):
            if option.startswith(("@", "-XX:VMOptionsFile=", "-XX:Flags=")):
                return 1
            name, _, value = option.partition("=")
            if name == "-Dcarlos_override_properties":
                selected = value
            elif name == "-Duser.home":
                home_args = ["-Duser.home=" + value]
    os.execve(java, [java, *home_args, "-cp", classpath,
                     "io.github.carlos_emr.carlos.config.PackagedReportLeaseCheck", classes, selected],
              environment)


if __name__ == "__main__":
    try:
        sys.exit(main(*sys.argv[1:]))
    except (OSError, ValueError, subprocess.CalledProcessError):
        # The package prints one actionable warning. Never print site option values.
        sys.exit(1)
