#
# Backup configuration and credentials for CARLOS EMR.
#
# MODE 0640, root:carlos-backup. It holds the restic repository passphrase and
# the read-only database password, so the application uid must never be able
# to read it — that separation is what stops a compromised EMR from deleting
# or decrypting its own backups.
#
# !!! COPY RESTIC_PASSWORD SOMEWHERE OFF THIS HOST, TODAY.
# !!! Without it every backup this machine has ever written is permanently
# !!! unreadable, and this file dies with the machine it is meant to protect.

# --- repository -------------------------------------------------------------
# The default is a local directory. That is a real first tier — it restores a
# dropped table in minutes — but a backup that lives on the machine it
# protects is NOT disaster recovery. Point this at an offsite backend and add
# its credentials before you consider the deployment finished:
#
#   RESTIC_REPOSITORY=s3:https://s3.example.ca/clinic-emr
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#
#   RESTIC_REPOSITORY=sftp:backup@backup.example.ca:/srv/carlos
#   (key-based auth only; carlos-backup's HOME is /var/backups/carlos-emr,
#   so ssh reads its keys and known_hosts from /var/backups/carlos-emr/.ssh/)
# Two more operational notes, both live-tested:
#  * VALUES HERE ARE PARSED BY THE SHELL (the script re-sources this file).
#    A password containing $ or backticks is EXPANDED before use, so what
#    you escrowed and what restic receives silently differ. The generated
#    credentials are plain alphanumerics; keep any hand-set value that way,
#    or single-quote it.
#  * The systemd units confine writes to /var/backups/carlos-emr and
#    /var/log/carlos-emr. A LOCAL repository anywhere else needs a drop-in:
#    systemctl edit carlos-emr-backup carlos-emr-backup-verify and add
#    [Service] ReadWritePaths=/your/path. Network repositories need nothing.
#  * The units allow 6 hours per run. The FIRST push of a large history to a
#    slow offsite link can exceed that (the run is killed and alerts
#    "aborted unexpectedly (exit 143)"): for the initial seed, raise the cap
#    once with `systemctl edit carlos-emr-backup` ([Service]
#    TimeoutStartSec=24h), start it, then remove the override. Later nights
#    are incremental and fast.
RESTIC_REPOSITORY=/var/backups/carlos-emr/restic-repo
RESTIC_PASSWORD=

# --- database credential ----------------------------------------------------
# A dedicated account with SELECT, SHOW VIEW, TRIGGER, EVENT, RELOAD,
# REPLICATION CLIENT and REPLICATION SLAVE — everything the dump
# (--single-transaction --master-data=2) and the binary-log streaming leg
# need and nothing more. Deliberately NOT PROCESS: a leak of
# this file would otherwise let an attacker watch every clinician's live SQL,
# bound PHI parameters included.
CARLOS_BACKUP_DB_USER=backup
CARLOS_BACKUP_DB_PASSWORD=
# HOST/PORT apply to the BINARY-LOG STREAMING leg only (it speaks the
# replication protocol, which needs a TCP endpoint). The dump and the restore
# drill always use the local unix socket: this package is single-host by
# design, and the socket avoids both a TLS question and a misleading client
# warning on loopback TCP.
CARLOS_BACKUP_DB_HOST=127.0.0.1
CARLOS_BACKUP_DB_PORT=3306
CARLOS_BACKUP_DB_NAME=oscar

# --- retention --------------------------------------------------------------
# Applied by `restic forget --prune` at the end of every run. The defaults keep
# a year of monthly restore points, which is usually the binding constraint
# for a clinical record — check it against your own retention obligations
# rather than assuming.
# QUOTE ANY VALUE CONTAINING SPACES. This file is read twice: by systemd
# (EnvironmentFile=) and by the backup script, which sources it with the shell
# so that a manual run behaves like the timer. systemd tolerates an unquoted
# multi-word value; the shell reads `VAR=a b` as "run b with VAR set" and the
# job dies with "command not found".
CARLOS_BACKUP_KEEP="--keep-daily 7 --keep-weekly 5 --keep-monthly 12"

# Binary-log snapshots have their OWN window (CARLOS_BACKUP_KEEP does not
# govern them): this is how far back point-in-time roll-forward reaches.
# A dump older than this window still restores, but only to its own
# instant — there are no logs left to roll it forward with. Raise it if you
# need PITR deeper than the last week of dumps; restic syntax, e.g. 9d, 30d.
CARLOS_BACKUP_BINLOG_KEEP=9d

# Full pack-data verification is expensive (it reads the entire repository) and
# is what catches bit rot that a structural `restic check` cannot. Run it on
# this ISO weekday, 1=Monday .. 7=Sunday; 0 disables it. The default is
# SATURDAY: the restore drill runs Sunday 04:30 and waits at most 2h for the
# backup lock, and a long read-data pass inside Sunday's 01:30 nightly held
# the lock past that — the drill then failed with a misleading alert.
CARLOS_BACKUP_CHECK_READ_DATA_DOW=6

# Scratch database the weekly restore drill loads the dump into. The database
# itself is created once by `carlos-ctl db-users` (the backup account holds
# rights on it but cannot create or drop databases); each drill EMPTIES it —
# every table inside is dropped — before loading the dump. Never point this at
# a database whose contents you care about.
CARLOS_BACKUP_VERIFY_DB=carlos_restore_drill

# --- notification -----------------------------------------------------------
# A backup failure that nobody hears about is the same as no backup. Set at
# least one of these. THE WEBHOOK IS THE RELIABLE CHANNEL: it needs only
# outbound HTTPS from the sandboxed unit. The email leg requires a mail(1)
# command (e.g. bsd-mailx) AND a working MTA whose submission path functions
# inside the unit's sandbox (ProtectSystem=strict — a socket-based relay like
# postfix works; direct spool writes do not); it is silently skipped when
# mail(1) is absent. Test it: systemctl start carlos-emr-backup after
# breaking something harmless, and confirm the message actually arrives.
CARLOS_BACKUP_ALERT_WEBHOOK=
CARLOS_BACKUP_ALERT_EMAIL=
