#
# Site configuration for CARLOS EMR.
#
# This file is OPERATOR-OWNED. The package writes it once, on first install,
# from the answers given to debconf, and never overwrites it again — an
# upgrade will not undo your edits, and equally will not add new keys, so read
# /usr/share/carlos-emr/skel/carlos-emr.env after an upgrade to see whether
# anything new is available.
#
# It is read by systemd (EnvironmentFile= in carlos-emr.service) and by
# carlosctl. systemd's parser is NOT a shell: no command substitution, no
# variable expansion, and values with spaces need quotes.
#
# Apply changes with:  systemctl restart carlos-emr

# --- identity ---------------------------------------------------------------
# The host name clinicians type. It is the nginx server_name, the subject of
# the TLS certificate, and the domain certbot requests. Changing it means
# re-running `carlosctl cert selfsigned` (or `carlosctl cert acme`).
CARLOS_SERVER_NAME=localhost

# Address nginx listens on. 0.0.0.0 serves every interface, which is what a
# clinic server needs; 127.0.0.1 restricts it to this host, which is what you
# want while staging a migration or when a separate reverse proxy fronts the
# machine.
CARLOS_BIND_IP=0.0.0.0

# Billing province: on (Ontario) or bc (British Columbia). This selects the
# Flyway migration location AND the application's billing behaviour, and it is
# NOT safe to change after the schema has been created — the province
# migrations create different tables. Reinstall against a fresh database
# instead.
CARLOS_PROVINCE=on

# Time zone used by the JVM. Clinical timestamps are stored and displayed in
# it, so it should match the clinic, not UTC.
CARLOS_TZ=America/Toronto

# --- JVM --------------------------------------------------------------------
# Heap. CARLOS is a large application; below 2 GB it will spend its time in
# garbage collection and eventually fail an import. Give it roughly half of
# physical memory on a dedicated host, leaving room for MariaDB's
# innodb_buffer_pool_size (/etc/mysql/mariadb.conf.d/60-carlos-emr.cnf) and
# about 1 GB for the operating system.
#
# Xms == Xmx on purpose: a server heap that grows on demand just pays for the
# same pages twice, and a fixed heap makes an out-of-memory condition
# reproducible instead of load-dependent.
CARLOS_JAVA_XMS=2g
CARLOS_JAVA_XMX=2g

# Extra JVM flags, appended last. Use for a profiler agent or a temporary -D
# override; anything permanent belongs in carlos.properties.
#
# QUOTE IT if it contains spaces. systemd would parse an unquoted value fine,
# but the start wrapper also sources this file with the shell so that a manual
# run behaves like the service, and to the shell `VAR=a b` means "run b with
# VAR set".
CARLOS_JAVA_OPTS=""

# --- database ---------------------------------------------------------------
# The application's own credentials live in /etc/carlos-emr/carlos.properties,
# not here — this file is world-readable to the carlos group and systemd
# copies EnvironmentFile values into the service environment, which any local
# user can read from /proc for a process they own.
CARLOS_DB_HOST=127.0.0.1
CARLOS_DB_PORT=3306
CARLOS_DB_NAME=oscar

# --- logging ----------------------------------------------------------------
# There is no verbosity knob here on purpose. The application's log levels come
# from its own Log4j2 configuration inside the WAR, and the container's come
# from /etc/carlos-emr/tomcat/logging.properties. Everything the JVM writes to
# stdout is in the journal:  carlosctl logs -f
#
# If you raise a level for troubleshooting, put it back. On this application
# DEBUG can put request parameters — which is to say PHI — into the log.
