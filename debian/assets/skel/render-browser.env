# Render browser service settings. Read by carlos-emr-chromedriver.service.
#
# This file is 0640 root:carlos-render. It is NOT readable by the `carlos`
# account, and carlos.properties (0640 root:carlos) is not readable by
# carlos-render — the two principals deliberately cannot read each other's
# configuration, which is why the url-base below is delivered twice rather than
# shared through one file.
#
# CARLOS_RENDER_URL_BASE is a bearer credential, not decoration. chromedriver has
# no authentication and any local account can reach a loopback port, so the path
# prefix is what stops another local uid driving the browser. It is generated
# once at install; rotating it means updating eform_pdf_browser_service_url in
# carlos.properties to match and restarting both units.
CARLOS_RENDER_PORT=9515
CARLOS_RENDER_URL_BASE=
