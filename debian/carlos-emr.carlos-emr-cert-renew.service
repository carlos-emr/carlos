[Unit]
Description=CARLOS EMR TLS certificate renewal
Documentation=file:///usr/share/doc/carlos-emr/README.Debian

[Service]
Type=oneshot
# Root is required here and only here among the recurring jobs: certbot writes
# under /etc/letsencrypt (root-only by design, it holds account and private
# keys) and the job reloads nginx. It touches no application data and holds no
# database credential.
ExecStart=/usr/lib/carlos-emr/carlos-emr-cert renew
TimeoutStartSec=30m

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
