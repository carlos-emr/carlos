[Unit]
# Bound a crash loop: with 15s restart spacing the default 5-in-10s limiter
# never trips, and an OOM loop (each crash writing an Xmx-sized PHI heap
# dump) ran forever. Six failures inside half an hour is a broken
# deployment — stop, stay failed, page whoever watches the unit. These are
# [Unit]-section options: in [Service], systemd 259 rejects the key and the
# bound silently did not exist (live-verified with systemd-analyze).
StartLimitIntervalSec=30min
StartLimitBurst=6
Description=CARLOS EMR application server (Tomcat 11)
Documentation=file:///usr/share/doc/carlos-emr/README.Debian
Documentation=https://github.com/carlos-emr/carlos
# The database is on this host and the application cannot serve a single page
# without it. Wants+After rather than Requires: a Requires would tear CARLOS
# down every time MariaDB was restarted for maintenance, and the start wrapper
# already waits for the database to answer before handing off to Tomcat.
Wants=mariadb.service network-online.target
After=mariadb.service network-online.target

[Service]
Type=exec
User=carlos
Group=carlos
UMask=0027

# Site knobs (heap size, timezone, DB host). Rendered by the package on first
# install and never overwritten afterwards — it is operator-owned.
EnvironmentFile=-/etc/carlos-emr/carlos-emr.env
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
# NOT the passwd home (/var/lib/carlos-emr): that is root-owned 0755 by the
# layout rule in carlos-emr.tmpfiles, and Chromium — which the eForm PDF
# renderer drives — cannot start without somewhere writable to put its
# crashpad database. It does not fail loudly either; it hangs until the
# renderer's startup budget expires. The JVM is unaffected because user.home
# is read from passwd rather than from this variable.
Environment=HOME=/var/lib/carlos-emr/browser
# EFORM_RENDER_SANDBOX is NOT set here — it is set by
# /usr/lib/systemd/system/carlos-emr.service.d/10-eform-renderer.conf, shipped by
# carlos-emr-eform-renderer, so that the flag cannot outlive the browser unit that
# satisfies it. Edit that file, not this one. What follows is the investigation
# that led here, recorded so the next person does not repeat it.
#
# Chromium's OS sandbox is the right posture for this component: the renderer
# opens clinic-authored eForm HTML, the least trustworthy input this application
# handles. carlos-emr-eform-renderer therefore ships the AppArmor profile that
# grants the browser back the `userns` permission Ubuntu 23.10+ removes, and
# with it loaded a sandboxed Chromium runs as the carlos user reliably — exit 0
# in about a second, repeatedly, print-to-PDF included.
#
# It does not work when the JVM spawns it under this unit. Measured on a clean
# 26.04 VM, sandboxed, the probe fails every boot with "Chromium session
# creation exceeded the 30s startup budget"; unsandboxed it passes every time
# and Chromium writes a full profile. The difference is this unit's own
# confinement, confirmed by relaxing all of it at once, which made the
# sandboxed probe pass.
#
# Narrowing it down did NOT converge. Individually, RestrictNamespaces,
# ProtectProc, NoNewPrivileges and SystemCallFilter each still failed. Two
# pairings (RestrictNamespaces + ProtectProc) passed once each and then did not
# reproduce with the same values written into this file, with orphaned browser
# processes cleared and a fresh HOME. So the interaction is real but not yet
# isolated, and anything shipped on the strength of those two runs would be
# built on noise.
#
# EFORM_RENDER_SANDBOX fails CLOSED. Enabling it in that state would not harden
# eForm rendering, it would make it fail — intermittently, in a clinic, for a
# security control that was not actually working. The gap is documented rather
# than papered over. To experiment:
#
#   (to experiment, edit the drop-in above rather than `systemctl edit`, which
#    would collide with it)    [Service]
#                                      Environment=EFORM_RENDER_SANDBOX=true
#                                      RestrictNamespaces=user pid net mnt
#                                      ProtectProc=ptraceable
#
# The durable fix is not to loosen this unit — that trades a PHI-handling
# Tomcat's confinement for one subprocess. It is to run the browser under its
# own confinement, which is an application change: EFormBrowserPdfService builds
# its ChromeDriverService with usingDriverExecutable() and spawns chromedriver
# in-process, so nothing outside the JVM can confine it separately today.

ExecStart=/usr/lib/carlos-emr/carlos-emr-tomcat run
# catalina.sh run execs the JVM, so systemd's SIGTERM reaches Java directly and
# Tomcat performs its normal shutdown. 143 is 128+SIGTERM, which is what a JVM
# exits with when it is asked to stop; without this systemd records every clean
# stop as a failure.
SuccessExitStatus=143
Restart=on-failure
RestartSec=15s
# A cold start explodes no WARs but does deploy a very large application and
# runs the Flyway boot validation against the database. Ten minutes is
# generous on purpose; the alternative is systemd killing a healthy start.
TimeoutStartSec=600
# Give in-flight clinical requests time to finish before the JVM is killed.
TimeoutStopSec=120

# --- sandboxing -------------------------------------------------------------
# The application handles PHI and parses untrusted input from the internet
# (through the WAF). Everything below narrows what a successful code-execution
# bug can reach. The four ReadWritePaths are the only writable locations:
# Tomcat's work/temp/logs and the document store.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=no
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
# ProcSubset=pid is deliberately NOT set. It would hide /proc/meminfo and
# /proc/cpuinfo, which the JVM reads to size the heap and the GC thread pool;
# with them gone HotSpot either misconfigures itself or refuses to start.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute is deliberately NOT set: the HotSpot JIT maps its
# code cache writable and then executable, and enabling it stops the JVM from
# starting at all. This is a known, accepted gap in the sandbox for any Java
# service.
# AF_NETLINK is needed alongside the obvious three: the JVM enumerates network
# interfaces through a netlink socket, and without it NetworkInterface calls
# fail in ways that surface as unrelated integration errors.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/carlos-emr /var/log/carlos-emr /run/carlos-emr

# A large webapp with a 200-connection Tomcat pool and a JDBC pool opens a lot
# of descriptors; the 1024 default is not enough and the failure looks like
# random request errors rather than a resource limit.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
