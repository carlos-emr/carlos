#!/bin/sh
# debconf question script for carlos-emr.
#
# It runs BEFORE the package is unpacked, and again on dpkg-reconfigure, so it
# may not touch anything the package installs. Its only job is to ask.
set -e

. /usr/share/debconf/confmodule

CONF_DIR=/etc/carlos-emr
ENV_FILE="${CONF_DIR}/carlos-emr.env"

# Seed the database from the existing configuration on reconfigure and upgrade,
# so the questions are pre-filled with what is actually deployed rather than
# with the package defaults. Without this, accepting the defaults on an upgrade
# would silently reset a configured host name back to "localhost".
if [ -r "${ENV_FILE}" ]; then
    for key in CARLOS_SERVER_NAME:server-name CARLOS_BIND_IP:bind-ip \
               CARLOS_PROVINCE:province CARLOS_JAVA_XMX:java-heap; do
        var="${key%%:*}"
        q="${key##*:}"
        # \042 is the double quote — spelled as an octal escape because a
        # literal one here confuses checkbashisms' lexer into reporting an
        # unterminated string for the whole file.
        val="$(sed -n "s/^${var}=//p" "${ENV_FILE}" | tr -d '\042' | head -1)"
        [ -n "${val}" ] && db_set "carlos-emr/${q}" "${val}"
    done
else
    # First install: offer the machine's own fully qualified name rather than
    # "localhost", which is almost never the right answer and which Let's
    # Encrypt cannot issue for.
    # Guarded by the seen flag for the same reason as java-heap below: an
    # UNATTENDED install preseeds this question with debconf-set-selections
    # (which marks it seen), and an unguarded db_set overwrote that answer with
    # the machine's hostname — silently discarding the operator's chosen name
    # and issuing the TLS certificate for the wrong subject. Only offer the
    # detected FQDN when nobody has answered the question.
    db_fget carlos-emr/server-name seen || true
    if [ "${RET}" != true ]; then
        fqdn="$(hostname -f 2>/dev/null || hostname 2>/dev/null || echo localhost)"
        case "${fqdn}" in
            ''|localhost|localhost.*) : ;;
            *) db_set carlos-emr/server-name "${fqdn}" ;;
        esac
    fi

    # First install only: recommend a heap sized for this machine instead of
    # the static 2g template default, the way the OSCAR 19 packaging did (it
    # took 60% of MemTotal, capped at 6g). This package's documented budget
    # is: heap gets about half of physical memory, the rest is left for
    # MariaDB's buffer pool and ~1 GB for the OS (carlos-emr.env,
    # 60-carlos-emr.cnf). Half of RAM, rounded to the nearest whole GB,
    # clamped to 2g (below which CARLOS thrashes in GC) .. 8g (past which a
    # single-clinic heap stops paying — surplus RAM belongs to
    # innodb_buffer_pool_size).
    #
    # This sits in the no-env-file branch on purpose: an operator-tuned
    # CARLOS_JAVA_XMX seeded above must never be replaced by the calculation,
    # and the seen flag alone cannot guarantee that — a noninteractive
    # install leaves questions unseen (debconf marks input seen only when a
    # frontend actually shows it, unless DEBCONF_NONINTERACTIVE_SEEN=true),
    # so an unattended upgrade would recompute over the deployed value. The
    # seen-flag guard below narrows first install further: a preseeded answer
    # (debconf-set-selections marks the question seen) also wins over the
    # calculation. If /proc/meminfo is unreadable — some containers — the
    # case guard falls through and the template's 2g default stands.
    db_fget carlos-emr/java-heap seen || true
    if [ "${RET}" != true ]; then
        # `|| true`: a missing /proc/meminfo fails the command substitution,
        # and under set -e a failed assignment would abort the whole script.
        mem_kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || true)"
        case "${mem_kb}" in
            ''|*[!0-9]*) : ;;
            *)
                # Target is MemTotal/2 expressed in GiB: mem_kb kB divided by
                # (2 * 1048576) kB/GiB = mem_kb / 2097152. Rounding to the
                # nearest integer adds half the divisor before the truncating
                # division: (mem_kb + 1048576) / 2097152.
                heap_gb=$(( (mem_kb + 1048576) / 2097152 ))
                if [ "${heap_gb}" -lt 2 ]; then heap_gb=2; fi
                if [ "${heap_gb}" -gt 8 ]; then heap_gb=8; fi
                db_set carlos-emr/java-heap "${heap_gb}g"
                ;;
        esac
    fi
fi

db_input high carlos-emr/server-name || true
db_input high carlos-emr/bind-ip || true
db_input high carlos-emr/province || true
db_input high carlos-emr/java-heap || true
db_input high carlos-emr/tls-mode || true
db_go || true

db_get carlos-emr/tls-mode
if [ "${RET}" = acme ]; then
    db_input high carlos-emr/acme-email || true
    db_go || true
fi

db_input high carlos-emr/reset-seed-admin || true
db_input high carlos-emr/install-demo-data || true
db_go || true

exit 0
