#!/bin/sh
# postrm for carlos-emr.
#
# THE RULE THIS FILE EXISTS TO ENFORCE: removing or purging this package NEVER
# destroys clinical data, and never destroys the material needed to read data
# that survives. Not on `remove`, not on `purge`, not on a failed upgrade, and
# not when apt is run non-interactively with every prompt defaulted.
#
# Concretely, nothing here touches:
#
#   the `carlos` and `drugref2` databases        the clinical record itself
#   /var/lib/carlos-emr/CarlosDocument           scanned patient documents
#   /var/backups/carlos-emr                     the backups and the restic repo
#   /etc/carlos-emr/carlos.properties           holds encryption.util.secret.key,
#                                               without which credentials stored
#                                               in the retained database cannot
#                                               be decrypted
#   /etc/carlos-emr/drugref2.properties         the DrugRef credential
#   /etc/carlos-emr/backup.env                  holds RESTIC_PASSWORD, without
#                                               which every backup ever written
#                                               is permanently unreadable
#   /var/log/carlos-emr                         access and WAF audit logs, which
#                                               a site may be obliged to retain
#
# Purge removes only what the package generated and what is regenerable in
# seconds: the nginx wiring, the TLS pair, Tomcat's scratch, ModSecurity's
# spool, the ACME webroot, and the plaintext first-login credential note (a
# secret on disk is a liability, not data).
#
# Deliberately, there is NO debconf question here offering to drop the
# database. A prompt is one keystroke away from a catastrophe on a system that
# holds patient records, and `apt purge -y` would answer it without a human in
# the room. The supported way to destroy data is an explicit, typed command run
# while the package is still installed and the operator is deliberately
# decommissioning the machine:
#
#     carlos-ctl destroy-data --confirm <server-name>
#
# which refuses unless the host's own configured name is typed back to it.

set -e

CONF_DIR=/etc/carlos-emr
STATE=/var/lib/carlos-emr

case "$1" in
    purge)
        # debconf answers are the package's own state, not the site's data.
        if [ -e /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            db_purge || true
        fi

        rm -f /etc/nginx/sites-enabled/carlos-emr

        # Generated, regenerable configuration. carlos-ctl init-config rebuilds
        # every one of these from carlos-emr.env in under a second.
        rm -rf "${CONF_DIR}/nginx"
        # The generated MariaDB drop-in (timezone/drill alignment) and its
        # short-lived earlier name — regenerated by db-apply-settings.
        rm -f /etc/mysql/mariadb.conf.d/61-carlos-emr.cnf \
              /etc/mysql/mariadb.conf.d/61-carlos-emr-tz.cnf
        # The repo-known marker's root-filesystem twin is package STATE, not
        # a log: left behind, it made a reinstall refuse to initialise its
        # genuinely fresh repository. (The log files beside it are retained,
        # per the rule at the top of this file.)
        rm -rf /var/log/carlos-emr/backup-state
        rm -f "${STATE}/.first-configure-pending" \
              "${STATE}/.consult-signature-default-migrated" \
              "${STATE}/.consult-fax-default-migrated" \
              "${STATE}/.db-name-default-migrated"
        # The OscarDocument -> CarlosDocument compat symlink is package
        # machinery, not data: the real document store it points at is KEPT.
        if [ -L "${STATE}/OscarDocument" ]; then
            rm -f "${STATE}/OscarDocument"
        fi
        # carlos-emr.env is generated by install_once (NOT a conffile, so dpkg
        # never removes it) and holds no secret and no data — only the server
        # name, bind IP, province, timezone, heap and DB coordinates. Leaving it
        # behind makes a later reinstall look "already configured": the province
        # / timezone freshness guard in postinst sees the env file present but
        # the .first-configure-pending sentinel gone (removed just above) and
        # takes the not-fresh branch, silently discarding the operator's fresh
        # debconf answers. Remove it so reinstall-after-purge is genuinely fresh.
        # (Its secret-bearing / data-bearing siblings carlos.properties and
        # backup.env are deliberately KEPT — see the rule at the top of this
        # file. The renderer package removes its own render-browser.env the same
        # way and for the same reason.)
        rm -f "${CONF_DIR}/carlos-emr.env"
        # The front-door TLS pair — but ONLY when it is material this package
        # generated (selfsigned) or merely links to (acme: the real files live
        # in /etc/letsencrypt, which belongs to certbot and is left alone).
        # In `manual` mode the pair was PLACED BY THE OPERATOR — possibly a
        # commercially purchased certificate — and purging someone's bought
        # key because they removed a package is not this script's call.
        if [ "$(cat "${CONF_DIR}/tls/mode" 2>/dev/null)" = manual ]; then
            echo "carlos-emr: /etc/carlos-emr/tls was KEPT: it holds an operator-supplied" >&2
            echo "carlos-emr: certificate (TLS mode 'manual'). Remove it yourself if unwanted." >&2
        else
            rm -rf "${CONF_DIR}/tls"
        fi
        # A plaintext administrator password sitting on a decommissioned disk
        # is a liability. The account it describes still exists in the retained
        # database; a reinstall issues a fresh one.
        rm -f "${CONF_DIR}/initial-admin.txt"

        # Tomcat scratch, the WAF spool and the ACME webroot: all rebuilt on
        # the next install, none of it a record of anything.
        rm -rf "${STATE}/catalina" "${STATE}/modsecurity" "${STATE}/acme"
        # Heap dumps are PHI, so they are NOT removed here — see the notice
        # below.

        cat >&2 <<'NOTICE'
carlos-emr: purge complete. NOTHING BELONGING TO THE CLINICAL RECORD WAS REMOVED.

  kept: the `carlos` and `drugref2` databases and their accounts
  kept: /var/lib/carlos-emr/CarlosDocument   (patient documents)
  kept: /var/lib/carlos-emr/heapdumps        (JVM heap dumps — treat as PHI)
  kept: /var/backups/carlos-emr              (backups and the restic repository)
  kept: /var/log/carlos-emr                  (access and WAF audit logs)
  kept: /etc/carlos-emr/carlos.properties    (holds encryption.util.secret.key —
        without it, credentials stored in the retained database cannot be
        decrypted, so deleting it destroys data even though it is a config file)
  kept: /etc/carlos-emr/backup.env           (holds RESTIC_PASSWORD — without it
        every backup this host ever wrote is permanently unreadable)
  kept: the `carlos` and `carlos-backup` system accounts, because files on this
        host are still owned by them and a reused uid would silently inherit
        patient documents

To destroy the data deliberately, reinstall the package and run
  carlos-ctl destroy-data --confirm <server-name>
or do it by hand:
  sudo mariadb -e "DROP DATABASE carlos; DROP DATABASE drugref2;"
  sudo shred -u /etc/carlos-emr/carlos.properties /etc/carlos-emr/backup.env
  sudo rm -rf /var/lib/carlos-emr /var/backups/carlos-emr /var/log/carlos-emr
NOTICE

        if [ -d /run/systemd/system ] && nginx -t >/dev/null 2>&1; then
            deb-systemd-invoke reload nginx.service || true
        fi
        ;;

    remove)
        # `remove` keeps ALL configuration, as dpkg intends — the package can
        # be reinstalled and pick up exactly where it left off. Only the nginx
        # wiring goes, because the site file it points at is gone.
        rm -f /etc/nginx/sites-enabled/carlos-emr
        if [ -d /run/systemd/system ] && nginx -t >/dev/null 2>&1; then
            deb-systemd-invoke reload nginx.service || true
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
