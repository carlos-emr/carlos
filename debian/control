Package: carlos-emr
# amd64, not all: this package carries the eForm-to-PDF renderer, a vendored
# x86-64 Chromium and chromedriver (see below). Saved-eForm print, fax and
# archive have no non-browser fallback, so the renderer is part of the EMR
# rather than an optional add-on, and the EMR therefore installs only where that
# Chromium runs. Through 2026.08.0~alpha13 the renderer was a separate
# carlos-emr-eform-renderer package and this one was Architecture: all; dpkg
# treats all -> amd64 under the same package name as an ordinary upgrade.
Architecture: amd64
Depends:
 ${misc:Depends},
 openjdk-25-jre-headless | openjdk-25-jdk-headless,
 tomcat11-common (>= 11.0),
 libtomcat11-java (>= 11.0),
 mariadb-server (>= 1:11.4),
 mariadb-client (>= 1:11.4),
 nginx (>= 1.25.1),
 libnginx-mod-http-modsecurity,
 modsecurity-crs,
 openssl,
 ca-certificates,
# libXrender.so.1 is a link-time dependency of the wkhtmltopdf native library
# bundled in the WAR (ultrabuk-htmltopdf-java), which renders encounter forms,
# HRM documents, form faxes and encrypted-email PDFs. Nothing else in this
# dependency set pulls libXrender in on a server install, so without it every
# one of those renders died with UnsatisfiedLinkError at request time while the
# rest of the application looked healthy.
 libxrender1,
 restic,
 adduser,
# deb-systemd-invoke, used by the maintainer scripts so that policy-rc.d is
# honoured in chroots and image builds.
 init-system-helpers (>= 1.54),
# curl: the postinst readiness probe and the backup job's failure webhook.
 curl,
# python3: the postinst parses the bind address with it, and the OSCAR 19
# import guard (carlos-emr-o19-guard, consulted by the service unit on every
# start) reads the import ledger with it.
 python3,
# The administration command: its own package from 2026.08.0~alpha16 (and
# the 2026.09.0~snapshot25 developer build; carlos-emr/carlos-ctl). Through
# 2026.08.0~alpha15 / snapshot24 the same code shipped inside this package.
# The postinst calls db-rename-schema, init-config,
# db-apply-settings, db-users, db-migrate, bootstrap-admin and demo-data, and
# carlos-emr-provision.service calls finish-install --boot, so the floor is
# the first carlos-ctl release that carries every one of those with the
# calling convention this postinst uses. Plain Depends suffices: no package
# here has a preinst, and dpkg configures a dependency before the depending
# package's postinst runs (Policy 7.2). Raise the floor whenever this
# package starts using a new verb or flag. carlos-ctl carries the
# python3-bcrypt, iproute2, procps and jq the CLI itself needs.
 carlos-ctl (>= 1.1.0),
 debconf (>= 0.5) | debconf-2.0,
# --- eForm renderer (vendored Chromium under /usr/lib/carlos-emr/chromium) ---
# Chromium's direct DT_NEEDED set, minus what the Essential/base system already
# guarantees. Derived by reading the shipped binary's dynamic section, not
# copied from a wiki page: dh_shlibdeps cannot compute it here because the
# binary is vendored rather than built by this source package.
#
# libc6 and libgcc-s1 are listed even though they are effectively always
# present: dh_shlibdeps normally adds them, and with it skipped nothing else
# would declare the C runtime that this package's ELF actually links against.
 libc6,
 libgcc-s1,
 libasound2t64,
 libatk-bridge2.0-0t64,
 libatk1.0-0t64,
 libatspi2.0-0t64,
 libcairo2,
 libcups2t64,
 libdbus-1-3,
 libexpat1,
 libgbm1,
 libglib2.0-0t64,
 libnspr4,
 libnss3,
 libpango-1.0-0,
 libudev1,
 libx11-6,
 libxcb1,
 libxcomposite1,
 libxdamage1,
 libxext6,
 libxfixes3,
 libxkbcommon0,
 libxrandr2,
# Not a link-time dependency: Chromium resolves fonts through fontconfig at
# render time, and on a font-less server every eForm PDF comes out with the
# glyphs missing rather than failing loudly.
 fontconfig,
 fonts-dejavu-core,
# apparmor supplies apparmor_parser, which the postinst uses to load the profile
# that makes Chromium's own sandbox usable on this distribution.
 apparmor
# The renderer used to be the separate carlos-emr-eform-renderer package. The
# files that keep their paths (the Chromium tree, the AppArmor profile, the
# carlos-emr.service drop-in) now belong to this package, so every pre-merge
# version has to hand them over (Replaces) and must not stay configured beside
# it (Breaks). The paths its purge script deletes or disables -- its unit,
# env file and browser home -- are deliberately NOT reused (see the postinst's
# one-time move), so that purge cannot reach anything carlos-emr runs.
#
# Breaks is a FIXED version: the last pre-merge release was 2026.08.0~alpha13,
# and the first to ship the transitional package sorts at or above
# 2026.08.0~alpha14~ (alpha14, an rc, or the final). A ${source:Version}-relative
# Breaks would also break the PREVIOUS release's transitional package, so an
# install that kept it could no longer be upgraded with --no-remove unless the
# operator remembered to supply the transitional deb every time. (A pre-merge
# renderer is forced out regardless by its own exact Depends on the carlos-emr
# it shipped with.) Replaces stays ${source:Version}-relative so the file
# takeover also works between developer snapshots built from this tree
# (2026.09.0~snapshotN -> snapshotN+1); the transitional package owns no files,
# so replacing it is a no-op. Going from a developer snapshot to a 2026.08
# release is NOT covered and not supported: 2026.09.0~snapshotN sorts above
# every 2026.08 version, so that move is a downgrade (apt refuses it without an
# explicit downgrade) and needs a remove-then-install. Snapshots are dev builds
# and are never published as release assets.
Breaks:
 carlos-emr-eform-renderer (<< 2026.08.0~alpha14~)
Replaces:
 carlos-emr-eform-renderer (<< ${source:Version})
Recommends:
# certbot only. NOT python3-certbot-nginx: carlos-emr-cert drives certbot with
# --webroot precisely so the plugin never rewrites
# /etc/nginx/sites-available/carlos-emr, which is a dpkg conffile.
 certbot,
# ${source:Version}, not ${binary:Version}: carlos-emr is architecture-specific
# and carlos-emr-drugref is Architecture: all, so a binNMU of one would never
# carry the other's binary version.
 carlos-emr-drugref (= ${source:Version}),
# logrotate consumes /etc/logrotate.d/carlos-emr; without it the ModSecurity
# audit log grows unbounded, so this is a strong recommendation rather than a
# suggestion.
 logrotate
Suggests:
 fail2ban,
 nftables
# The tomcat11 SERVICE package, not the libraries. CARLOS deliberately depends
# on tomcat11-common and libtomcat11-java only — the distribution's Tomcat CODE,
# so container CVEs still arrive through apt — and runs its own private
# instance: CATALINA_BASE=/var/lib/carlos-emr/catalina, user carlos, connector
# bound to 127.0.0.1:18080 behind the nginx/ModSecurity front door, serving a
# docBase the application's own uid cannot write to.
#
# The tomcat11 package instead starts a SECOND container as user tomcat that
# listens on *:8080 — every interface, with no TLS, no WAF or rate limit —
# creating another network service outside the packaged front door. It does
# not serve CARLOS by default, but competes for the memory the EMR heap was
# sized against.
#
# Operators install it by reflex ("CARLOS is a Java webapp, so it needs
# Tomcat"), and the result is a machine that looks subtly wrong rather than
# obviously broken. Refuse the combination outright.
Conflicts: tomcat11
Description: CARLOS EMR - Canadian electronic medical record (single-host deployment)
 CARLOS (Clinical Assisting Recording Ledger Open Source) is an open-source
 electronic medical record for Canadian primary care, with HL7 and FHIR
 interfaces and Ontario and British Columbia billing support.
 .
 This package deploys the whole system on one machine: the CARLOS web
 application on a dedicated Tomcat 11 instance, a MariaDB schema provisioned
 with least-privilege accounts, and an nginx front door running ModSecurity 3
 with the OWASP Core Rule Set in blocking mode. TLS is on by default with a
 self-signed certificate that can be replaced by a certbot-managed Let's
 Encrypt certificate at any time. Nightly restic backups and a weekly restore
 drill are installed as systemd timers.
 .
 Every long-running component is unprivileged: the application runs as the
 system user "carlos", backups as "carlos-backup", nginx as "www-data" and
 MariaDB as "mysql". Root is used only by the package maintainer scripts and
 by the certificate-renewal timer.
 .
 Saved-eForm print, fax and archive are produced by rendering the form in a
 real browser and printing it to PDF over the Chrome DevTools Protocol. Ubuntu
 26.04 ships Chromium only as a snap, which cannot read the renderer's working
 directories, so this package includes a pinned Chromium and matching
 chromedriver under /usr/lib/carlos-emr/chromium. The driver runs as the
 carlos-emr-render-browser service under its own account, "carlos-render" (a
 member of no group), which is the only unit on the host permitted to create
 namespaces, so Chromium keeps its own sandbox while the EMR's service stays
 confined. The application connects to it over loopback and never launches a
 browser itself. This is why the package is built for amd64 only.
 .
 An experimental migration path imports an existing OSCAR 19 clinic into a
 fresh install; see carlos-ctl(8), verbs import-o19 and o19-preflight.
 .
 For a container-based, multi-pod deployment with an observability stack see
 the carlos-podman project instead.

Package: carlos-emr-drugref
Architecture: all
Depends:
 ${misc:Depends},
# Exact version: the two packages ship one Tomcat instance and one set of
# database accounts between them, and carlos-emr-drugref's postinst calls
# carlos-ctl from carlos-emr. Written as the ${source:Version} range because
# this package is Architecture: all and carlos-emr is not: an exact version
# would make DrugRef uninstallable beside a binNMU of carlos-emr (X+b1), and
# ${binary:Version} is lintian's not-binnmuable-all-depends-any. The range admits
# exactly this source version and its binNMUs.
 carlos-emr (>= ${source:Version}),
 carlos-emr (<< ${source:Version}.1~),
# mariadb-client (not -core) for the schema load; the -core package has the
# client but not the tooling the rest of this deployment uses.
 mariadb-client (>= 1:11.4),
# The postinst calls `carlos-ctl db-users`. Already pulled in through
# carlos-emr, but named for visibility: the CLI is its own package.
 carlos-ctl,
# deb-systemd-invoke, to start MariaDB and to restart the shared Tomcat after
# (un)deploying the DrugRef context.
 init-system-helpers (>= 1.54),
# curl: the postinst waits for the restarted Tomcat to serve DrugRef.
 curl
Description: DrugRef2 drug reference service for CARLOS EMR
 DrugRef2 is the drug and drug-interaction reference service CARLOS queries
 over XML-RPC when a prescription is written. It is built from
 carlos-emr/drugref2026 and deployed as a second web application in the
 CARLOS Tomcat instance, reachable only over the host loopback interface.
 .
 The package creates the drugref2 database, loads the Health Canada Drug
 Product Database seed shipped with CARLOS, and points the EMR at the local
 service. Without it, CARLOS prescription drug lookups return no results.

Package: carlos-emr-eform-renderer
# Transitional. The renderer now ships inside carlos-emr itself (see the
# Breaks/Replaces there). Its only job is convenience: with it in the same apt
# command, a pre-merge renderer is UPGRADED to this empty package, so the
# documented --no-remove upgrade from 2026.08.0~alpha13 or earlier succeeds
# instead of stopping on a removal. It is not a safety device: carlos-emr runs
# the render browser under names the old package's scripts never touch
# (carlos-emr-render-browser.service, /etc/carlos-emr/renderer.env,
# /var/lib/carlos-emr/renderer), so removing or purging the old renderer at any
# time cannot break it (a purge of a REMOVED old renderer still runs its old
# postrm, which re-runs init-config and restarts the EMR once -- verified). Depends with >= so a copy left installed keeps satisfying
# later carlos-emr releases; safe to remove or purge once installed.
Architecture: all
Section: oldlibs
Depends:
 ${misc:Depends},
 carlos-emr (>= ${source:Version}),
# The pre-merge renderer's postrm (still run when a REMOVED old renderer is
# purged) calls `carlos-ctl init-config`, guarded by `command -v carlos-ctl`.
# Named for visibility: the CLI is its own package, pulled in via carlos-emr.
 carlos-ctl
Description: transitional package for the CARLOS EMR eForm renderer
 The headless Chromium renderer for CARLOS EMR eForm PDFs is now part of the
 carlos-emr package. This empty transitional package upgrades installations of
 the former separate renderer package cleanly and can be removed afterwards.
