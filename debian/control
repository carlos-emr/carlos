 libnginx-mod-http-modsecurity,
 modsecurity-crs,
 openssl,
 ca-certificates,
# libXrender.so.1 is a link-time dependency of the wkhtmltopdf native library
# bundled in the WAR (ultrabuk-htmltopdf-java), which renders encounter forms,
# HRM documents, form faxes and encrypted-email PDFs. Nothing else in this
# dependency set pulls libXrender in on a server install, so without it every
# one of those renders died with UnsatisfiedLinkError at request time while the
# rest of the application looked healthy.
 libxrender1,
 restic,
 adduser,
# deb-systemd-invoke, used by the maintainer scripts so that policy-rc.d is
# honoured in chroots and image builds.
 init-system-helpers (>= 1.54),
# curl: the postinst readiness probe, `carlos-ctl check`, and the backup job's
# failure webhook.
 curl,
# ss, for the listening-socket assertions in `carlos-ctl check`.
 iproute2,
# ps, for the "no component runs as root" assertion in `carlos-ctl check`.
 procps,
# python3-bcrypt hashes the replacement for the seeded administrator password.
 python3,
 python3-bcrypt,
 debconf (>= 0.5) | debconf-2.0
Recommends:
# certbot only. NOT python3-certbot-nginx: carlos-emr-cert drives certbot with
# --webroot precisely so the plugin never rewrites
# /etc/nginx/sites-available/carlos-emr, which is a dpkg conffile.
 certbot,
 carlos-emr-drugref (= ${binary:Version}),
# The eForm-to-PDF renderer. Recommended, not required: it carries a vendored
# Chromium (~150 MB) and only saved-eForm print/fax/archive needs it. Without
# it those three workflows are unavailable and the package says so at install
# time; every other PDF in CARLOS is produced by a pure-Java library.
 carlos-emr-eform-renderer (= ${binary:Version}),
# logrotate consumes /etc/logrotate.d/carlos-emr; without it the ModSecurity
# audit log grows unbounded, so this is a strong recommendation rather than a
# suggestion.
 logrotate,
# jq makes `carlos-ctl waf tail` readable; it degrades to raw JSON without it.
 jq
Suggests:
 fail2ban,
 nftables
Description: CARLOS EMR - Canadian electronic medical record (single-host deployment)
 CARLOS (Clinical Assisting Recording Ledger Open Source) is an open-source
 electronic medical record for Canadian primary care, with HL7 and FHIR
 interfaces and Ontario and British Columbia billing support.
 .
 This package deploys the whole system on one machine: the CARLOS web
 application on a dedicated Tomcat 11 instance, a MariaDB schema provisioned
 with least-privilege accounts, and an nginx front door running ModSecurity 3
 with the OWASP Core Rule Set in blocking mode. TLS is on by default with a
 self-signed certificate that can be replaced by a certbot-managed Let's
 Encrypt certificate at any time. Nightly restic backups and a weekly restore
 drill are installed as systemd timers.
 .
 Every long-running component is unprivileged: the application runs as the
 system user "carlos", backups as "carlos-backup", nginx as "www-data" and
 MariaDB as "mysql". Root is used only by the package maintainer scripts and
 by the certificate-renewal timer.
 .
 For a container-based, multi-pod deployment with an observability stack see
 the carlos-podman project instead.

Package: carlos-emr-drugref
Architecture: all
Depends:
 ${misc:Depends},
# Exact version: the two packages ship one Tomcat instance and one set of
# database accounts between them, and carlos-emr-drugref's postinst calls
# carlos-ctl from carlos-emr.
 carlos-emr (= ${binary:Version}),
# mariadb-client (not -core) for the schema load; the -core package has the
# client but not the tooling the rest of this deployment uses.
 mariadb-client (>= 1:11.4),
# deb-systemd-invoke, to restart the shared Tomcat after (un)deploying the
# DrugRef context.
 init-system-helpers (>= 1.54)
Description: DrugRef2 drug reference service for CARLOS EMR
 DrugRef2 is the drug and drug-interaction reference service CARLOS queries
 over XML-RPC when a prescription is written. It is built from
 carlos-emr/drugref2026 and deployed as a second web application in the
 CARLOS Tomcat instance, reachable only over the host loopback interface.
 .
 The package creates the drugref2 database, loads the Health Canada Drug
 Product Database seed shipped with CARLOS, and points the EMR at the local
 service. Without it, CARLOS prescription drug lookups return no results.

Package: carlos-emr-eform-renderer
Architecture: amd64
Depends:
 ${misc:Depends},
# Exact version: the renderer's properties are written into carlos.properties by
# carlos-emr's carlos-ctl, and this package's postinst calls it to do so.
 carlos-emr (= ${binary:Version}),
 init-system-helpers (>= 1.54),
# Chromium's direct DT_NEEDED set, minus what the Essential/base system already
# guarantees (libc6, libgcc-s1). Derived by reading the shipped binary's dynamic
# section, not copied from a wiki page: dh_shlibdeps cannot compute it here
# because the binary is vendored rather than built by this source package.
#
# libc6 and libgcc-s1 are listed even though they are effectively always
# present: dh_shlibdeps normally adds them, and with it skipped nothing else
# would declare the C runtime that this package's ELF actually links against.
 libc6,
 libgcc-s1,
 libasound2t64,
 libatk-bridge2.0-0t64,
 libatk1.0-0t64,
 libatspi2.0-0t64,
 libcairo2,
 libcups2t64,
 libdbus-1-3,
 libexpat1,
 libgbm1,
 libglib2.0-0t64,
 libnspr4,
 libnss3,
 libpango-1.0-0,
 libudev1,
 libx11-6,
 libxcb1,
 libxcomposite1,
 libxdamage1,
 libxext6,
 libxfixes3,
 libxkbcommon0,
 libxrandr2,
# Not a link-time dependency: Chromium resolves fonts through fontconfig at
# render time, and on a font-less server every eForm PDF comes out with the
# glyphs missing rather than failing loudly.
 fontconfig,
 fonts-dejavu-core
Description: Headless Chromium renderer for CARLOS EMR eForm PDFs
 Saved-eForm print, fax and archive in CARLOS are produced by rendering the
 form in a real browser and printing it to PDF over the Chrome DevTools
 Protocol. There is no legacy fallback path: without a browser those three
 workflows are unavailable.
 .
 Ubuntu 26.04 ships Chromium only as a snap, and a confined snap cannot read
 the renderer's working directories under /var/lib/carlos-emr. This package
 therefore installs a pinned, unconfined Chromium and a chromedriver built from
 the same revision into /usr/lib/carlos-emr/chromium, and points
 eform_pdf_browser_chromium_path and eform_pdf_browser_chromedriver_path at
 them so the renderer never has to download a driver at first use.
 .
 Installing this package also turns the boot-time renderer probe back on, so a
 broken browser is reported once in the journal at startup instead of surfacing
 as a failed print in the middle of a consultation.
