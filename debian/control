# DO NOT BUMP THIS WITHOUT READING THIS PARAGRAPH.
#
# dh_installtmpfiles only generates its remove/purge snippet when NOT compat 13
# (see the `! compat(13)` guard in /usr/bin/dh_installtmpfiles). At compat 14 it
# would start running `systemd-tmpfiles --purge` over debian/carlos-emr.tmpfiles
# when this package is purged -- and that file lists
# /var/lib/carlos-emr/CarlosDocument, the scanned patient record store, and
# /var/backups/carlos-emr. carlos-emr.postrm exists precisely to guarantee that
# removing this package never deletes either.
#
# debhelper 13.31 has no --no-purge/--no-remove to opt out with (the flags are
# referenced in the tool but not wired to command-line options), so on a compat
# bump the guard must be re-established some other way -- verify what purge does
# to those two paths BEFORE the bump, not after.
 debhelper-compat (= 13),
# dh_installsysusers and the `installsysusers` sequence addon arrived in
# debhelper 13.6; compat 13 alone is satisfied by older versions that would
# silently build a package with no system accounts declared.
#
# 13.14.1, not 13.6: the render browser unit is staged by debian/rules into
# usr/lib/systemd/system and picked up by `dh_installsystemd --name` from
# there. Verified against the shipped tools: 13.11.4 (Debian 12) scans only
# lib/systemd/system, so it would build a package whose enable/stop snippets
# are missing and whose render browser is never enabled -- a silent
# eForm print/fax/archive outage -- while 13.14.1 (Ubuntu 24.04) and 13.31
# (Ubuntu 26.04) scan both. Raise this only alongside a check of the
# dh_installsystemd unit-directory scan.
 debhelper (>= 13.14.1~),
 maven,
 openjdk-25-jdk-headless,
 tomcat11,
 ca-certificates,
 git,
 xz-utils,
# curl and unzip fetch and unpack the pinned Chromium carlos-emr ships for its
# eForm renderer (debian/fetch-chromium.sh). Not needed when the
# build supplies CHROMIUM_DIST or sets SKIP_EFORM_RENDERER.
 curl,
 unzip
