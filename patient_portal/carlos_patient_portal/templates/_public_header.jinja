<header class="patient-topbar">
  <div class="brand-lockup">
    <img src="{{ url_for('static', path='/carlos-logo.png') }}" alt="{{ text.logo_alt }}" class="brand-logo">
    <div>
      <strong>{{ service_name }}</strong>
      <span>{{ clinic_name }}</span>
    </div>
  </div>
  <div class="language-switch" aria-label="{{ text.language_aria_label }}">
    {# The active locale is already in use, so it must not offer the "unavailable" explanation the
       not-yet-translated locales carry; without this it told the patient English was unavailable
       while rendering the page in English. #}
    {% for language in supported_locales %}
      <button
        class="text-tab{% if language.is_selected %} selected{% else %} modal-trigger{% endif %}"
        type="button"
        aria-pressed="{{ 'true' if language.is_selected else 'false' }}"
        {% if not language.is_selected %}
          data-modal-title="{{ text.language_unavailable_title }}"
          data-modal-message="{{ text.language_unavailable_message }}"
        {% else %}
          disabled
        {% endif %}
        data-language-code="{{ language.code }}"
      >{{ language.short_label }}</button>
    {% endfor %}
  </div>
</header>
