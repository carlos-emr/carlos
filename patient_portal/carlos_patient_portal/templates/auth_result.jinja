<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ service_name }}</title>
  {% include "_head_assets.jinja" %}
  <link rel="stylesheet" href="{{ url_for('static', path='/styles.css') }}">
  <script src="{{ url_for('static', path='/portal.js') }}" defer></script>
</head>
<body>
  <main class="app-shell">
    <section class="portal-screen" aria-label="{{ result_heading }}">
      {% include "_public_header.jinja" %}
      <div class="auth-layout">
        <section class="auth-panel auth-result" aria-labelledby="auth-result-title">
          <h1 id="auth-result-title">{{ result_heading }}</h1>
          <p class="form-notice" role="status">{{ result_message }}</p>
          <a class="primary-action" href="/">{{ text.sign_in_button }}</a>
        </section>
      </div>
      {% include "_public_modal.jinja" %}
    </section>
  </main>
</body>
</html>
