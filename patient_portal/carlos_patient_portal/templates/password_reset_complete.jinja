<!doctype html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ service_name }}</title>
  {% include "_head_assets.jinja" %}
  <link rel="stylesheet" href="{{ url_for('static', path='/styles.css') }}">
  <script src="{{ url_for('static', path='/portal.js') }}" defer></script>
</head>
<body>
  <main class="app-shell">
    <section class="portal-screen" aria-label="{{ text.password_reset_complete_heading }}">
      {% include "_public_header.jinja" %}
      <div class="auth-layout">
        <section class="auth-panel" aria-labelledby="reset-complete-title">
          <h1 id="reset-complete-title">{{ text.password_reset_complete_heading }}</h1>
          {% if error_message %}
            <p class="form-error" role="alert">{{ error_message }}</p>
          {% endif %}
          <p class="form-error" role="alert" tabindex="-1" data-reset-token-error hidden>
            {{ text.password_reset_complete_error }}
          </p>
          <form
            class="form-stack"
            method="post"
            action="{{ url_for('complete_reset') }}"
            data-reset-token-form
          >
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="reset_token" value="{{ reset_token or '' }}" data-reset-token>
            <label>
              <span>{{ text.new_password }}</span>
              <input type="password" name="new_password" autocomplete="new-password" required>
            </label>
            <label>
              <span>{{ text.new_password_confirmation }}</span>
              <input type="password" name="new_password_confirmation" autocomplete="new-password" required>
            </label>
            <p class="clinic-help-line">{{ text.password_requirements }}</p>
            <button class="primary-action" type="submit">{{ text.password_reset_update }}</button>
          </form>
          <a class="auth-back-link" href="{{ url_for('index').path }}">{{ text.back_to_sign_in }}</a>
        </section>
      </div>
      {% include "_public_modal.jinja" %}
    </section>
  </main>
</body>
</html>
