<!doctype html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ service_name }}</title>
  {% include "_head_assets.jinja" %}
  <link rel="stylesheet" href="{{ url_for('static', path='/styles.css') }}">
  <script src="{{ url_for('static', path='/portal.js') }}" defer></script>
</head>
<body>
  <main class="app-shell">
    <section class="portal-screen" aria-label="{{ text.password_reset_request_heading }}">
      {% include "_public_header.jinja" %}
      <div class="auth-layout">
        <section class="auth-panel" aria-labelledby="reset-request-title">
          <h1 id="reset-request-title">{{ text.password_reset_request_heading }}</h1>
          <p class="auth-intro">{{ text.password_reset_request_details }}</p>
          <p class="clinic-help-line">{{ text.forgot_username_help }}</p>
          {% if error_message %}
            <p class="form-error" role="alert">{{ error_message }}</p>
          {% endif %}
          {% if notice_message %}
            <p class="form-notice" role="status">{{ notice_message }}</p>
          {% endif %}
          {% if development_reset_url %}
            <p class="development-link">
              {{ text.development_reset_link }}
              <a href="{{ development_reset_url }}">{{ text.open_reset_page }}</a>
            </p>
          {% endif %}
          <form class="form-stack" method="post" action="{{ url_for('request_reset') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <label>
              <span>{{ text.username }}</span>
              <input
                type="text"
                name="username"
                value="{{ form_values.username or '' }}"
                autocomplete="username"
                required
              >
            </label>
            <label>
              <span>{{ text.email }}</span>
              <input
                type="email"
                name="email"
                value="{{ form_values.email or '' }}"
                maxlength="254"
                autocomplete="email"
                required
              >
            </label>
            <button class="primary-action" type="submit">{{ text.password_reset_send }}</button>
          </form>
          <a class="auth-back-link" href="{{ url_for('index').path }}">{{ text.back_to_sign_in }}</a>
        </section>
      </div>
      {% include "_public_modal.jinja" %}
    </section>
  </main>
</body>
</html>
