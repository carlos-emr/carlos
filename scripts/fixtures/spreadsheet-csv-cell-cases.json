      "expected": "\t=HYPERLINK(\"synthetic\",\"quoted,\r\nvalue\")"
    },
    {
      "input": "",
      "expected": ""
    },
    {
      "input": "Zo\u00eb",
      "expected": "Zo\u00eb"
    },
    {
      "input": "O'Neil",
      "expected": "O'Neil"
    },
    {
      "input": "a,b",
      "expected": "a,b"
    },
    {
      "input": "a\"b",
      "expected": "a\"b"
    },
    {
      "input": "a\r\nb",
      "expected": "a\r\nb"
    },
    {
      "input": "value=1",
      "expected": "value=1"
    },
    {
      "input": "42",
      "expected": "42"
