{
  "description": "Spreadsheet formula-guard cell policy (issue #5846). Read by SpreadsheetCsvUnitTest (the server, SpreadsheetCsv.sanitizeCell) and scripts/table-export.test.js (the page, TableExport.sanitizeCell in js/table-export.js) so CSV exports built on either side guard the same cells. 'expected' is the cell text before CSV quoting: a guarded cell gains a leading tab.",
  "cases": [
    {
      "input": "=1+1",
      "expected": "\t=1+1"
    },
    {
      "input": "+SUM(A1)",
      "expected": "\t+SUM(A1)"
    },
    {
      "input": "-cmd",
      "expected": "\t-cmd"
    },
    {
      "input": "@SUM(A1)",
      "expected": "\t@SUM(A1)"
    },
    {
      "input": "  =1+1",
      "expected": "\t  =1+1"
    },
    {
      "input": " \t@SUM(A1)",
      "expected": "\t \t@SUM(A1)"
    },
    {
      "input": "\tname",
      "expected": "\t\tname"
    },
    {
      "input": "\rname",
      "expected": "\t\rname"
    },
    {
      "input": "\nname",
      "expected": "\t\nname"
    },
    {
      "input": "\r\n=1+1",
      "expected": "\t\r\n=1+1"
    },
    {
      "input": "\u0000=1+1",
      "expected": "\t\u0000=1+1"
    },
    {
      "input": "\u001b+1",
      "expected": "\t\u001b+1"
    },
    {
      "input": "\u00a0=1+1",
      "expected": "\t\u00a0=1+1"
    },
    {
      "input": "\u2003@SUM(A1)",
      "expected": "\t\u2003@SUM(A1)"
    },
    {
      "input": "\ufeff=1+1",
      "expected": "\t\ufeff=1+1"
    },
    {
      "input": "\uff1d1+1",
      "expected": "\t\uff1d1+1"
    },
    {
      "input": "\uff0bSUM(A1)",
      "expected": "\t\uff0bSUM(A1)"
    },
    {
      "input": "\uff0dcmd",
      "expected": "\t\uff0dcmd"
    },
    {
      "input": "\uff20SUM(A1)",
      "expected": "\t\uff20SUM(A1)"
    },
    {
      "input": " \ufeff\uff1d1+1",
      "expected": "\t \ufeff\uff1d1+1"
    },
    {
      "input": "-",
      "expected": "\t-"
    },
    {
      "input": "-.",
      "expected": "\t-."
    },
    {
      "input": "-e2",
      "expected": "\t-e2"
