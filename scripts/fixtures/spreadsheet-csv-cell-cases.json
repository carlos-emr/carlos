    {
      "input": "-1e",
      "expected": "\t-1e"
    },
    {
      "input": "-1E+",
      "expected": "\t-1E+"
    },
    {
      "input": "-1e2+3",
      "expected": "\t-1e2+3"
    },
    {
      "input": "--12",
      "expected": "\t--12"
    },
    {
      "input": "-12.5.6",
      "expected": "\t-12.5.6"
    },
    {
      "input": "-NaN",
      "expected": "\t-NaN"
    },
    {
      "input": "-Infinity",
      "expected": "\t-Infinity"
    },
    {
      "input": "\t-12.5",
      "expected": "\t\t-12.5"
    },
    {
      "input": "\r-12.5",
      "expected": "\t\r-12.5"
    },
    {
      "input": "\n-12.5",
      "expected": "\t\n-12.5"
    },
    {
      "input": "-1+2",
      "expected": "\t-1+2"
    },
    {
      "input": "-1E3+2",
      "expected": "\t-1E3+2"
    },
    {
      "input": "-cmd|x",
      "expected": "\t-cmd|x"
    },
    {
