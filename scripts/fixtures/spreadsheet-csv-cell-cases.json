    {
      "input": "-.5",
      "expected": "-.5"
    },
    {
      "input": "-1.",
      "expected": "-1."
    },
    {
      "input": "-1.2E-7",
      "expected": "-1.2E-7"
    },
    {
      "input": "-2e+10",
      "expected": "-2e+10"
    },
    {
      "input": "  ordinary text",
      "expected": "  ordinary text"
    },
    {
      "input": "  -12.50",
      "expected": "  -12.50"
    },
    {
      "input": "\u00a0-12.50",
      "expected": "\u00a0-12.50"
    },
    {
      "input": "\u2003-1.2E-7",
      "expected": "\u2003-1.2E-7"
    },
    {
      "input": "\ufeff-12.50",
      "expected": "\ufeff-12.50"
    },
    {
      "input": "-0.01",
      "expected": "-0.01"
    },
    {
      "input": "-123",
      "expected": "-123"
    }
  ]
}
