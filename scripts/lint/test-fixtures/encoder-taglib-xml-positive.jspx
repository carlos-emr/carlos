<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0"
          xmlns:e="urn:jsptld:owasp.encoder.jakarta.advanced">
    <jsp:directive.taglib prefix="legacy" uri="https://www.owasp.org/index.php/OWASP_Java_Encoder_Project"/>
    <p>fixture</p>
</jsp:root>
