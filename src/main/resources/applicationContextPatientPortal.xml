<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
      Patient portal integration (issue #3475). Picked up automatically by the
      classpath:applicationContext*.xml pattern in web.xml.

      EVERY BEAN HERE IS lazy-init. This is the load-bearing detail, not a tuning choice.

      PatientPortalSettings.fromCarlosProperties() throws when the portal is unconfigured, which is
      correct at a call site — a portal call must never silently become a no-op a clinic would
      misread as "the invitation was sent". But an eager bean whose factory throws fails the whole
      Spring context refresh, so that same fail-closed rule would stop CARLOS starting at all for
      every clinic that does not use the portal. Most will not. Lazy initialisation keeps the
      failure where it belongs: at the moment someone tries to use a portal that is not there.

      EVERY BEAN IS ALSO autowire-candidate="false". lazy-init alone is NOT enough, which a
      deployed CARLOS proved: spring_ws.xml declares beans that autowire by type, and by-type
      resolution instantiates candidate beans to inspect them. That defeated lazy-init, constructed
      PatientPortalSettings during context refresh on a server with no portal configured, and the
      whole webapp failed to start. Excluding these from autowiring restores the guarantee. Lookup
      by type through SpringUtils still works: autowire-candidate governs autowiring, not getBean.

      PatientPortalService holds a pooled HTTP client, hence destroy-method="close".
    -->

    <bean id="patientPortalSettings"
          class="io.github.carlos_emr.carlos.integration.patientportal.PatientPortalSettings"
          factory-method="fromCarlosProperties"
          lazy-init="true"
          autowire-candidate="false"/>

    <bean id="patientPortalService"
          class="io.github.carlos_emr.carlos.integration.patientportal.PatientPortalService"
          destroy-method="close"
          lazy-init="true"
          autowire-candidate="false">
        <constructor-arg ref="patientPortalSettings"/>
    </bean>

    <!--
      The resolver reads SecurityInfoManager only, so it constructs whether or not a portal is
      configured. Still lazy for symmetry: nothing should touch this package on a deployment that
      does not use it.
    -->
    <bean id="portalStaffContextResolver"
          class="io.github.carlos_emr.carlos.integration.patientportal.PortalStaffContextResolver"
          lazy-init="true"
          autowire-candidate="false">
        <!-- SecurityInfoManager is an interface; the @Service implementation registers under the
             default name derived from its class, so the reference is to the implementation. -->
        <constructor-arg ref="securityInfoManagerImpl"/>
    </bean>

</beans>
