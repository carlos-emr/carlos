      "type": "varchar(20)",
      "nullable": "YES",
      "charset": "utf8mb4",
      "collation": "utf8mb4_bin",
      "expression": "case when char_length(replace(`hin`,' ','')) <= 20 then replace(`hin`,' ','') else NULL end"
    },
