{
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "evidence"],
        "properties": {
          "kind": {"type": "string", "enum": ["tickler", "history"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    }
  }
}
