{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sections",
    "claims",
    "coverage"
  ],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "claim_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "clinical_overview",
              "active_problems",
              "medications_allergies",
              "results_observations",
              "plan_follow_up"
            ]
          },
          "title": {
            "type": "string",
            "enum": [
              "Clinical overview",
              "Active problems",
              "Medications and allergies",
              "Results and observations",
              "Plan and follow-up"
            ]
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\r\\n]+$"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "status",
          "reason"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "cited",
              "reviewed_not_cited",
              "excluded"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    }
  }
}
