<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
<!--        <File name="File" fileName="${catalina.base}/logs/openo.log" append="true">-->
<!--            <Log4j1XmlLayout />-->
<!--        </File>-->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d %-5p %C{2} (%F:%L) - %m%n"/>
        </Console>
<!--        <RollingFile name="rollingFile"-->
<!--                     fileName="logs/openo.log" filePattern="logs/oscar-%d{yyyy-MM-dd-HH-mm}-%i.log">-->
<!--            <PatternLayout>-->
<!--                <Pattern>%d{yyyy-MM-dd-HH:mm:ss} %-5p %m%n</Pattern>-->
<!--            </PatternLayout>-->
<!--            <Policies>-->
<!--                <SizeBasedTriggeringPolicy size="10KB" />-->
<!--            </Policies>-->
<!--        </RollingFile>-->
        <RollingFile name="CsrfFile" fileName="${sys:catalina.base:-${sys:java.io.tmpdir}}/logs/csrf.log"
                     filePattern="${sys:catalina.base:-${sys:java.io.tmpdir}}/logs/csrf-%d{yyyy-MM-dd}-%i.log.gz"
                     append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %replace{%m}{[\r\n\t]}{_}%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>
        <RollingFile name="WafFile" fileName="${sys:catalina.base:-${sys:java.io.tmpdir}}/logs/waf.log"
                     filePattern="${sys:catalina.base:-${sys:java.io.tmpdir}}/logs/waf-%d{yyyy-MM-dd}-%i.log.gz"
                     append="true">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %replace{%m}{[\r\n\t]}{_}%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="org.owasp.csrfguard" level="warn" additivity="false">
            <AppenderRef ref="CsrfFile"/>
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="waf.ratelimit" level="warn" additivity="false">
            <AppenderRef ref="WafFile"/>
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- The eForm render browser reports its startup probe at INFO ("eForm browser
             renderer startup check passed.") and its failures at WARN. The root logger
             defaulted to ERROR when this was written (it is WARN now, see Root below), so
             at default verbosity BOTH were invisible: a healthy
             renderer said nothing, and a broken one showed only the low-level detail
             line without the summary that names the component. That is the whole
             diagnostic story for saved-eForm print/fax/archive, and it is what
             README.Debian and docs/eform-browser-pdf-renderer.md tell operators to look
             for, so it has to be visible without raising LOG_VERBOSITY for the entire
             application. Scoped to this package only; INFO here is a handful of lines
             per start, not per request. -->
        <!-- Scoped to the STARTUP VALIDATOR CLASS, not the eform.util package: the package's
             per-render INFO lines embed fdid, a PHI-correlating operational identifier that must
             not become visible at default verbosity. The validator emits only the handful of
             startup-check lines the docs tell operators to look for, and nothing per-render.
             additivity="false" because this logger references Console itself — without it every
             probe line also propagated to the Root logger's Console appender and printed twice. -->
        <Logger name="io.github.carlos_emr.carlos.eform.util.EFormBrowserRendererStartupValidator"
                level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- Hibernate's deprecation channel. HHH90000033 (the deprecated @Temporal annotation)
             alone is one WARN line per mapped date column, roughly 850 lines at every start, for
             a migration that is tracked as a whole rather than actionable line by line. Holding
             this one category at ERROR is what lets the Root default below be WARN without the
             journal opening on a wall of the same line; raise it while doing that migration. -->
        <Logger name="org.hibernate.orm.deprecation" level="error"/>
        <!-- Struts' Dispatcher answers a request that matches no action with a 404 and logs
             "Could not find action or result: <request URI>?<query string>" at WARN with a stack
             trace (struts2-core 7.1.1, devMode off). The query string is caller-controlled and a
             stale bookmark or mistyped chart link carries demographic_no, names and health
             numbers, so the line puts PHI in the journal (issue #4570, finding 204). The page the
             user sees is a clean 404; this drops only that one framework message, whatever
             LOG_VERBOSITY is set to. Other Dispatcher output (real failures) is untouched, and
             the 404 itself stays visible in the Tomcat access log, which does not record the
             query string by default. The pattern is matched against the formatted message, (?s)
             so an encoded line break in the URI cannot slip past a '.'.
             A log4j.override.configuration file REPLACES this whole configuration
             (MiscUtils.addLoggingOverrideConfiguration), so an operator's override must carry
             this filter too or the query string returns to the journal. -->
        <Logger name="org.apache.struts2.dispatcher.Dispatcher">
            <RegexFilter regex="(?s)Could not find action or result.*" onMatch="DENY" onMismatch="NEUTRAL"/>
        </Logger>
        <!-- Flying Saucer, the HTML-to-PDF renderer, can log the text it is printing: with
             xr.renderer.replace-missing-characters on, every line that has a character missing from
             its font is logged at INFO. The documents are patients' records. CARLOS never sets that
             switch, and this keeps the library at WARN whatever LOG_VERBOSITY is, so raising the
             verbosity for troubleshooting (debug-on) cannot turn its INFO and DEBUG output on.
             A log4j.override.configuration file REPLACES this whole configuration
             (MiscUtils.addLoggingOverrideConfiguration), so an operator's override must carry this
             line too. -->
        <Logger name="org.xhtmlrenderer" level="warn"/>
        <!-- Flying Saucer's SVG support logs "Error while rendering SVG" at WARN with the exception Batik
             threw, and Batik's message quotes the reference it could not follow: a fragment id the
             document chose or a whole data: URI, which is the picture in a patient's record. The
             pipeline leaves a failed SVG out of the page and logs the class of the exception itself
             (BoundedOutputDevice), so the library's line adds nothing but the quotation.
             Same override rule as above. -->
        <Logger name="org.xhtmlrenderer.pdf.SvgImage" level="error"/>
        <Logger name="org.apache.log4j.xml" level="error">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="openjpa.jdbc.SQL" level="error">
            <AppenderRef ref="Console"/>
        </Logger>
        <!-- WARN, not ERROR: at ERROR the application was silent about everything short of a
             failure it had already given up on, which hid the class of defect where a request
             dies quietly. DEBUG can put request parameters, which is to say PHI, into the log;
             LOG_VERBOSITY is the operator's knob for a bounded troubleshooting window. -->
        <Root level="${env:LOG_VERBOSITY:-warn}">
            <AppenderRef ref="Console" />
<!--            <AppenderRef ref="File" />-->
        </Root>
    </Loggers>
</Configuration>