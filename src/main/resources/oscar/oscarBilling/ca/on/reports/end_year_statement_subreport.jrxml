<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="end_year_end_subreport" columnCount="1" printOrder="Vertical" orientation="Portrait" pageWidth="595" pageHeight="842" columnWidth="535" columnSpacing="0" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" whenNoDataType="NoPages" titleNewPage="false" summaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import>java.util.*</import>
	<import>net.sf.jasperreports.engine.*</import>
	<import>net.sf.jasperreports.engine.data.*</import>
	<parameter name="invoiceId" forPrompting="true" class="java.lang.Integer" />
	<query><![CDATA[SELECT bi.`service_code`, bi.`fee` FROM `billing_on_item` bi WHERE ch1_id = $P{invoiceId} AND (bi.status IS NULL OR bi.status <> 'D') ORDER BY bi.service_code, bi.id]]></query>
	<field name="service_code" class="java.lang.String" />
	<field name="fee" class="java.lang.String" />
	<background height="0">
			</background>
	<title height="0">
			</title>
	<pageHeader height="0">
			</pageHeader>
	<columnHeader height="0">
			</columnHeader>
	<detail>
		<band height="18">
			<element kind="textField" x="0" y="0" width="120" height="18" key="textField" blankWhenNull="false" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self">
				<box />
				<expression><![CDATA[$F{service_code}]]></expression>
			</element>
			<element kind="textField" x="120" y="0" width="100" height="18" key="textField" blankWhenNull="false" evaluationTime="Now" hyperlinkType="None" hyperlinkTarget="Self">
				<box />
				<expression><![CDATA[io.github.carlos_emr.carlos.PMmodule.utility.Utility.toCurrency($F{fee})]]></expression>
			</element>
		</band>
	</detail>
	<columnFooter height="0">
			</columnFooter>
	<pageFooter height="0">
			</pageFooter>
	<summary height="0">
			</summary>
</jasperReport>
