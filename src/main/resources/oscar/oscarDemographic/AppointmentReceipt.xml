<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="label" pageWidth="229" pageHeight="210" columnWidth="200" leftMargin="15" rightMargin="14" topMargin="0" bottomMargin="4">
    <parameter name="clinicName" class="java.lang.String" />
    <parameter name="clinicAddress" class="java.lang.String" />
    <parameter name="clinicCity" class="java.lang.String" />
    <parameter name="clinicProvince" class="java.lang.String" />
    <parameter name="clinicPostal" class="java.lang.String" />
    <parameter name="clinicPhone" class="java.lang.String" />
    <parameter name="clinicFax" class="java.lang.String" />
    <parameter name="apptDate" class="java.lang.String" />
    <parameter name="apptName" class="java.lang.String" />
    <parameter name="apptTime" class="java.lang.String" />
    <parameter name="apptId" class="java.lang.String" />
    <parameter name="DOB" class="java.lang.String" />
    <parameter name="printedDateTime" class="java.lang.String" />
    <parameter name="providerName" class="java.lang.String" />
    <parameter name="report.appointmentReceipt.Name" class="java.lang.String" />
    <parameter name="report.appointmentReceipt.DOB" class="java.lang.String" />
    <parameter name="report.appointmentReceipt.Date" class="java.lang.String" />
    <parameter name="report.appointmentReceipt.Time" class="java.lang.String" />
    <parameter name="report.appointmentReceipt.With" class="java.lang.String" />
    <parameter name="report.appointmentReceipt.Printed" class="java.lang.String" />
    <!-- Keep the existing paper size. Wrapped fields move following rows down and
         can continue onto another page instead of clipping identity or booking data. -->
    <title height="190" splitType="Stretch">
        <element kind="textField" positionType="Float" x="0" y="10" width="200" height="14" fontSize="10.0" bold="true" textAdjust="StretchHeight">
            <expression><![CDATA[$P{clinicName}]]></expression>
        </element>
        <element kind="textField" positionType="Float" x="0" y="24" width="200" height="14" fontSize="10.0" textAdjust="StretchHeight">
            <expression><![CDATA[$P{clinicAddress}]]></expression>
        </element>
        <element kind="textField" positionType="Float" x="0" y="38" width="200" height="14" fontSize="10.0" textAdjust="StretchHeight">
            <expression><![CDATA[$P{clinicCity} + ", " + $P{clinicProvince} + " " + $P{clinicPostal}]]></expression>
        </element>
        <element kind="textField" positionType="Float" x="0" y="52" width="200" height="14" fontSize="10.0" textAdjust="StretchHeight">
            <expression><![CDATA["Phone:" + $P{clinicPhone} + "  Fax:" + $P{clinicFax}]]></expression>
        </element>
        <element kind="line" positionType="Float" x="0" y="69" width="200" height="1" />
        <element kind="textField" positionType="Float" x="0" y="74" width="200" height="14" fontSize="10.0" textAdjust="StretchHeight">
            <expression><![CDATA[$P{report.appointmentReceipt.Name} + ": " + $P{apptName}]]></expression>
        </element>
        <element kind="textField" positionType="Float" x="0" y="88" width="200" height="14" fontSize="10.0" textAdjust="StretchHeight">
            <expression><![CDATA[$P{report.appointmentReceipt.DOB} + ": " + $P{DOB}]]></expression>
        </element>
        <element kind="textField" positionType="Float" x="0" y="102" width="200" height="14" fontSize="10.0" textAdjust="StretchHeight">
            <expression><![CDATA[$P{report.appointmentReceipt.Date} + ": " + $P{apptDate}]]></expression>
        </element>
        <element kind="textField" positionType="Float" x="0" y="116" width="200" height="14" fontSize="10.0" textAdjust="StretchHeight">
            <expression><![CDATA[$P{report.appointmentReceipt.Time} + ": " + $P{apptTime}]]></expression>
        </element>
        <element kind="textField" positionType="Float" x="0" y="130" width="200" height="14" fontSize="10.0" textAdjust="StretchHeight">
            <expression><![CDATA[$P{report.appointmentReceipt.With} + ": " + $P{providerName}]]></expression>
        </element>
        <element kind="line" positionType="Float" x="0" y="149" width="200" height="1" />
        <element kind="textField" positionType="Float" x="0" y="154" width="200" height="14" fontSize="8.0" textAdjust="StretchHeight">
            <expression><![CDATA[$P{report.appointmentReceipt.Printed} + " " + $P{printedDateTime} + " #" + $P{apptId}]]></expression>
        </element>
    </title>
</jasperReport>
