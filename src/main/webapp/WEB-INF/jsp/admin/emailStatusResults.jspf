<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib uri="carlos" prefix="carlos" %>
<fmt:setBundle basename="oscarResources"/>
<c:if test="${not empty emailValidationError}">
<div class="alert alert-danger mt-1" role="alert">${carlos:forHtml(emailValidationError)}</div>
</c:if>
<c:forEach items="${ emailStatusResults }" var="emailStatusResult" varStatus="loop">
<c:set var="emailStatusDetail" value="${emailStatusResult.errorMessage}"/>
<c:if test="${emailStatusResult.status eq 'PENDING' and empty emailStatusDetail}">
    <fmt:message key="admin.manageEmails.pendingDetail" var="emailStatusDetail"/>
</c:if>
<%-- SUCCESS only records that the SMTP relay or API accepted the message. A later bounce is never
     written back, so the tag must not read as delivered (issue #3834): it says "ACCEPTED BY MAIL
     SERVER" in a neutral grey, not the green of RESOLVED. The stored value and the filter value stay
     SUCCESS. --%>
<c:set var="emailStatusLabel" value="${emailStatusResult.status}"/>
<c:set var="emailStatusClass" value="status-tag-${fn:toLowerCase(emailStatusResult.status)}"/>
<c:if test="${emailStatusResult.status eq 'SUCCESS'}">
    <fmt:message key="admin.manageEmails.acceptedByMailServer" var="emailStatusLabel"/>
    <c:set var="emailStatusClass" value="status-tag-accepted"/>
</c:if>
<!-- Email Card -->
<div class="card email-status-card mt-1">
    <div class="card-body vertical-status-divider vertical-status-divider-${fn:toLowerCase(emailStatusResult.status)}" id="cardBody${emailStatusResult.logId}">
        <table class="email-info-table table table-borderless">
            <tr>
                <th>Subject</th>
                <td>${carlos:forHtml(emailStatusResult.subject)}</td>                      
            </tr>
            <tr>
                <th>From</th>
                <td>${carlos:forHtml(emailStatusResult.senderFullName)} &lt;${carlos:forHtml(emailStatusResult.senderEmail)}&gt;</td>
            </tr>
            <tr>
                <th>To</th>
                <td>${carlos:forHtml(emailStatusResult.recipientFullName)} &lt;${carlos:forHtml(emailStatusResult.recipientEmail)}&gt;</td>
            </tr>
            <tr>
                <th>Encryption</th>
                <td>
                <c:choose>
                    <c:when test="${emailStatusResult.isEncrypted}">
                        <%-- The PDF password is deliberately not rendered here (issue #3112): show only
                             that the email was encrypted, never the credential itself. --%>
                        <i class="fa-solid fa-lock"></i> Encrypted
                    </c:when>
                    <c:otherwise>
                        <i class="fa-solid fa-unlock"></i> Unencrypted
                    </c:otherwise>
                </c:choose>
                </td>
            </tr>
            <tr>
                <th><fmt:message key="email.admin.label.consent"/></th>
                <td>
                    <c:if test="${not empty emailStatusResult.consentMessageKey}">
                        <fmt:message key="${emailStatusResult.consentMessageKey}"/>
                    </c:if>
                    <c:if test="${not empty emailStatusResult.consentId}">
                        <c:choose>
                            <c:when test="${not empty emailStatusResult.consentLastUpdateDisplay}">
                                (<fmt:message key="email.admin.consentRecordAsOf">
                                    <fmt:param value="${emailStatusResult.consentId}"/>
                                    <fmt:param value="${emailStatusResult.consentLastUpdateDisplay}"/>
                                </fmt:message>)
                            </c:when>
                            <c:otherwise>
                                (<fmt:message key="email.admin.consentRecord">
                                    <fmt:param value="${emailStatusResult.consentId}"/>
                                </fmt:message>)
                            </c:otherwise>
                        </c:choose>
                    </c:if>
                    <c:if test="${emailStatusResult.consentOverride}">
                        <span class="badge bg-warning text-dark"><fmt:message key="email.admin.label.override"/></span>
                        <div>${carlos:forHtml(emailStatusResult.consentOverrideReason)}</div>
                    </c:if>
                </td>
            </tr>
        </table>
        
        <table class="table table-borderless">
            <tr>
                <td class="status-and-date">
                    <div class="status-tag ${emailStatusClass}" id="emailStatus${emailStatusResult.logId}"
                        ${ empty emailStatusDetail ? '' : "data-bs-toggle='popover'" } data-bs-trigger='hover click' data-bs-content="${carlos:forHtmlAttribute(emailStatusDetail)}">
                        ${carlos:forHtml(emailStatusLabel)}
                    </div>
                    <div class="date-time text-muted">
                        ${carlos:forHtml(emailStatusResult.createdDate)} &#x2022; ${carlos:forHtml(emailStatusResult.createdTime)} 
                        <c:if test="${not empty emailStatusResult.providerFullName}">
							by ${carlos:forHtml(emailStatusResult.providerFullName)}
						</c:if>
                    </div>
                </td>
                <td class="action-menu">
                    <c:if test="${canResolveEmails and emailStatusResult.resolvable}">
                        <button type="button" class="btn btn-outline-secondary btnResolve" id="btnResolve${emailStatusResult.logId}" onclick="resolve('${emailStatusResult.logId}')"><i class="fa-solid fa-circle-check"></i> Resolve</button>
                    </c:if>
                    <c:if test="${emailStatusResult.status ne 'PENDING' or emailStatusResult.resolvable}">
                        <button type="button" class="btn btn-success btnResend" id="btnResend${emailStatusResult.logId}" onclick="resend('${emailStatusResult.logId}')"><i class="fa-solid fa-envelope"></i> Copy and Open as New Email to Patient</button>
                    </c:if>
                </td>
            </tr>
        </table>
    </div>
</div>
<!-- End Email Card -->
</c:forEach>
