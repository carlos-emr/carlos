<%--
    smsQueueRows.jspf: one page of a message list on the SMS queue page (statically included by
    smsQueue.jsp).

    Parameters: the including page sets "queueList" (a SmsQueueViewModel.RowList: the page's rows, how
    many of its messages were left out because the viewer has no access to their patients, and where
    the page is in the list) and "queueListId" (the id of the list's heading, which names the page links
    and is where they return to) in page scope. It also relies on the page's "ctx" and on the c, fmt
    and carlos taglibs it declares.

    Paging: a list longer than one page gets "Rows 21-40 of N" and Previous / Next page links. The links'
    query strings are built by SmsQueuePages from the time period's own value and the page parameters'
    names and numbers, never from request text, and are still encoded here.

    Security: rows are redacted view-model records: no message text, only the recipient's last four
    digits, and the patient only as a plain demographic number (no link), shown only when
    smsQueue.demographicNumbersShown is set. Hidden messages are only counted; nothing else about them
    reaches this fragment. Every value is encoded; the status label key is built only from the
    SmsStatus enum name.

    The page already declares these taglibs and the bundle; repeating them keeps the fragment
    self-contained for the i18n lint and JspTaglibDeclarationRegressionTest, which check each JSP and
    fragment on its own.

    @since 2026-09-28
--%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ taglib uri="jakarta.tags.fmt" prefix="fmt" %>
<%@ taglib uri="carlos" prefix="carlos" %>
<fmt:setBundle basename="oscarResources"/>
<c:set var="queuePaging" value="${queueList.paging}"/>
<c:if test="${queuePaging.pageCount > 1}">
    <%-- Named by the list's heading, so each list's page links are told apart. --%>
    <nav class="d-flex flex-wrap align-items-center gap-2 small mb-1 sms-queue-paging"
         aria-labelledby="<carlos:encode value='${queueListId}' context='htmlAttribute'/>">
        <span>
            <fmt:message key="sms.queue.page.rows">
                <fmt:param value="${queuePaging.firstRow}"/>
                <fmt:param value="${queuePaging.lastRow}"/>
                <fmt:param value="${queuePaging.rowCount}"/>
            </fmt:message>
        </span>
        <c:choose>
            <c:when test="${not empty queuePaging.previousQuery}">
                <a class="btn btn-sm btn-outline-secondary" rel="prev"
                   href="${ctx}/admin/SmsQueue?<carlos:encode value='${queuePaging.previousQuery}' context='htmlAttribute'/>#<carlos:encode value='${queueListId}' context='htmlAttribute'/>"><fmt:message key="sms.queue.page.previous"/></a>
            </c:when>
            <c:otherwise>
                <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true"><fmt:message key="sms.queue.page.previous"/></span>
            </c:otherwise>
        </c:choose>
        <c:choose>
            <c:when test="${not empty queuePaging.nextQuery}">
                <a class="btn btn-sm btn-outline-secondary" rel="next"
                   href="${ctx}/admin/SmsQueue?<carlos:encode value='${queuePaging.nextQuery}' context='htmlAttribute'/>#<carlos:encode value='${queueListId}' context='htmlAttribute'/>"><fmt:message key="sms.queue.page.next"/></a>
            </c:when>
            <c:otherwise>
                <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true"><fmt:message key="sms.queue.page.next"/></span>
            </c:otherwise>
        </c:choose>
    </nav>
</c:if>
<c:set var="queueRows" value="${queueList.rows}"/>
<c:if test="${not empty queueRows}">
<div class="table-responsive">
    <table class="table table-sm table-striped small align-middle">
        <thead>
        <tr>
            <th scope="col"><fmt:message key="sms.queue.col.id"/></th>
            <th scope="col"><fmt:message key="sms.queue.col.status"/></th>
            <th scope="col"><fmt:message key="sms.queue.col.created"/></th>
            <th scope="col"><fmt:message key="sms.queue.col.updated"/></th>
            <th scope="col"><fmt:message key="sms.queue.col.due"/></th>
            <th scope="col"><fmt:message key="sms.queue.col.lastAttempt"/></th>
            <th scope="col"><fmt:message key="sms.queue.col.attempts"/></th>
            <th scope="col"><fmt:message key="sms.queue.col.errorCode"/></th>
            <th scope="col"><fmt:message key="sms.queue.col.reasonCode"/></th>
            <c:if test="${smsQueue.demographicNumbersShown}">
                <th scope="col"><fmt:message key="sms.queue.col.demographicNo"/></th>
            </c:if>
            <th scope="col"><fmt:message key="sms.queue.col.recipient"/></th>
        </tr>
        </thead>
        <tbody>
        <c:forEach items="${queueRows}" var="row">
            <tr>
                <td><carlos:encode value="${row.id}"/></td>
                <td><fmt:message key="sms.queue.status.${row.status}"/></td>
                <td><carlos:encode value="${row.createdAt}"/></td>
                <td><carlos:encode value="${row.updatedAt}"/></td>
                <td><carlos:encode value="${row.dueAt}"/></td>
                <td><carlos:encode value="${row.lastAttemptAt}"/></td>
                <td><carlos:encode value="${row.attemptCount}"/></td>
                <td><carlos:encode value="${row.errorCode}"/></td>
                <td><carlos:encode value="${row.consentReasonCode}"/></td>
                <c:if test="${smsQueue.demographicNumbersShown}">
                    <td><carlos:encode value="${row.demographicNo}"/></td>
                </c:if>
                <td><carlos:encode value="${row.recipientLastFour}"/></td>
            </tr>
        </c:forEach>
        </tbody>
    </table>
</div>
</c:if>
<c:if test="${queueList.hiddenCount > 0}">
    <p class="small text-muted">
        <fmt:message key="sms.queue.page.hidden">
            <fmt:param value="${queueList.hiddenCount}"/>
        </fmt:message>
    </p>
</c:if>
