<%--
  Fragment role: Provides the `billingReport_flu.jspf` include for the Ontario billing workflow.
  The caller owns request setup; keep data access in Java assemblers/services
  and use CARLOS encoding helpers for dynamic output rendered here.
  Lists the provider's Ontario claims with a flu-shot service code (G590A, or G591A on older claims),
  newest first, as one list with a count and a total (#5093). Each claim opens read-only.
--%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ taglib uri="carlos" prefix="carlos" %>
<%@ taglib uri="jakarta.tags.fmt" prefix="fmt" %>
<fmt:setBundle basename="oscarResources"/>

<table width="100%" border="2" cellpadding="0" cellspacing="0" style="font-family: Arial, Helvetica, sans-serif; font-size: small;">
<c:choose>
<c:when test="${empty billingReportFragmentModel.fluRows}">
    <tr>
        <td>No flu billing rows found.</td>
    </tr>
</c:when>
<c:otherwise>
    <tr bgcolor="#CCCCFF">
        <TH scope="col" align="center" width="10%"><b>INVOICE</b></TH>
        <TH scope="col" align="center" width="35%"><b>PATIENT</b></TH>
        <TH scope="col" align="center" width="20%"><b>DATE</b></TH>
        <TH scope="col" align="center" width="15%"><b>BILLED</b></TH>
        <TH scope="col" align="center" width="20%"><b>STATUS</b></TH>
    </tr>
    <c:forEach var="row" items="${billingReportFragmentModel.fluRows}">
    <tr bgcolor="<carlos:encode value='${row.rowBgColor}' context='htmlAttribute'/>">
        <TD align="left" width="10%"><b><a href=#
            onClick='popupPage(700,720, "${pageContext.request.contextPath}/billing/CA/ON/ViewBillingONDisplay?billing_no=<carlos:encode value='${row.billingId}' context='uriComponent'/>")'
            title="<carlos:encode value='${row.reasonCode}' context='htmlAttribute'/>"> <carlos:encode value="${row.billingId}" context="html"/></a></b></TD>
        <TD align="left" width="35%"><b><carlos:encode value="${row.demoName}" context="html"/></b></TD>
        <TD align="left" width="20%"><b><carlos:encode value="${row.apptDate}" context="html"/></b></TD>
        <TD align="right" width="15%"><b><carlos:encode value="${row.total}" context="html"/></b></TD>
        <TD align="center" width="20%"><b><carlos:encode value="${row.statusLabel}" context="html"/></b></TD>
    </tr>
    </c:forEach>
    <tr bgcolor="ivory">
        <TD align="left"><b>Total</b></TD>
        <TD colspan="2" align="left"><b><fmt:message key="billing.flu.count"><fmt:param value="${billingReportFragmentModel.fluCount}"/></fmt:message></b></TD>
        <TD align="right"><b><carlos:encode value="${billingReportFragmentModel.fluTotal}" context="html"/></b></TD>
        <TD align="center"><b>&nbsp;</b></TD>
    </tr>
</c:otherwise>
</c:choose>
</table>
