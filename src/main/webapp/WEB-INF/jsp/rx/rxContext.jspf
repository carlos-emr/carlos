<%@ taglib uri="carlos" prefix="rxcontext" %>
<meta name="rx-context-id" content="<rxcontext:encode value='${requestScope.rxContextId}' context='htmlAttribute'/>" />
<meta name="rx-context-path" content="<rxcontext:encode value='${pageContext.request.contextPath}' context='htmlAttribute'/>" />
<meta name="rx-demographic-no" content="<rxcontext:encode value='${requestScope.rxDemographicNo}' context='htmlAttribute'/>" />
<meta name="rx-appointment-no" content="<rxcontext:encode value='${requestScope.rxAppointmentNo}' context='htmlAttribute'/>" />
<meta name="rx-program-id" content="<rxcontext:encode value='${requestScope.rxProgramId}' context='htmlAttribute'/>" />
<meta name="rx-context-owner" content="<rxcontext:encode value='${requestScope.rxContextOwnerPage}' context='htmlAttribute'/>" />
<script type="text/javascript" src="<rxcontext:encode value='${pageContext.request.contextPath}' context='htmlAttribute'/>/oscarRx/js/rxSessionInterceptor.js"></script>
