<%@page import="io.github.carlos_emr.carlos.utility.SpringUtils" %>
<%@page import="io.github.carlos_emr.carlos.commn.model.Demographic" %>
<%@page import="io.github.carlos_emr.carlos.commn.dao.DemographicDao" %>
<%@page import="io.github.carlos_emr.carlos.commn.model.DemographicCust"%>
<%@page import="io.github.carlos_emr.carlos.commn.dao.DemographicCustDao"%>
<%@page import="io.github.carlos_emr.carlos.utility.SafeEncode" %>

<%@ taglib uri="/WEB-INF/oscar-tag.tld" prefix="oscar"%>
<%@ taglib uri="jakarta.tags.fmt" prefix="fmt" %>

<style>
.print{display:none;}

@media print{
.DoNotPrint{display: none}
.print{display:block}
}
</style>
<%
String d = null;
if(request.getParameter("demographic_no")!=null){
	d = request.getParameter("demographic_no");
}else if(request.getParameter("demo")!=null){
	d = request.getParameter("demo");
}else{
	d = request.getParameter("demographic");
}

DemographicDao demographicDao_header = SpringUtils.getBean(DemographicDao.class);
Demographic demographic_header=demographicDao_header.getDemographic(d);

DemographicCust demographicCust = null;
if (demographic_header != null) {
	DemographicCustDao demographicCustDao = (DemographicCustDao)SpringUtils.getBean(DemographicCustDao.class);
	demographicCust = demographicCustDao.find(demographic_header.getDemographicNo());
}

String alert = "";
if (demographicCust != null && demographicCust.getAlert() != null) {
	alert = demographicCust.getAlert();
}

String demographicEditUrl = request.getContextPath()
		+ "/demographic/DemographicEdit?demographic_no="
		+ SafeEncode.forUriComponent(d);
%>

<% if (demographic_header != null) { %>
<div id="demoHeader" class="navbar fixed-top card card-body p-0" style="padding:0px;margin:0px;">
<!--<a><fmt:setBundle basename="oscarResources"/><fmt:message key="demographic.demographiceditdemographic.msgNextAppt"/>: <oscar:nextAppt demographicNo='<%=d%>' /></a>-->

<div style="display:inline-block;margin-left:15px;">
<h4 class="DoNotPrint"><a href="<%= SafeEncode.forHtmlAttribute(demographicEditUrl) %>" style="color:#333;text-decoration:none;"><%= SafeEncode.forHtml(demographic_header.getLastName()) %>, <%= SafeEncode.forHtml(demographic_header.getFirstName()) %> <%if(demographic_header.getTitle() != null && !demographic_header.getTitle().isEmpty()) {%>(<%= SafeEncode.forHtml(demographic_header.getTitle()) %>) <%}%></a>


<%if(alert.length()!=0){%>
<a title="<%= SafeEncode.forHtmlAttribute(alert) %>"><i class="fa-solid fa-triangle-exclamation"></i></a>
<%}%>
</h4>

<h4 class="print"><%= SafeEncode.forHtml(demographic_header.getLastName()) %>, <%= SafeEncode.forHtml(demographic_header.getFirstName()) %> <%if(demographic_header.getTitle() != null && !demographic_header.getTitle().isEmpty()) {%>(<%= SafeEncode.forHtml(demographic_header.getTitle()) %>) <%}%></h4>
</div>



<div class="float-end" style="display:inline-block;margin-right:15px;text-align:right;padding-top:8px;">


<span style="padding-right:10px;font-size:14px;"><fmt:setBundle basename="oscarResources"/><fmt:message key="demographic.patient.context.born"/>: <strong><%= SafeEncode.forHtml(demographic_header.getFormattedDob()) %>  <%if(demographic_header.getAgeInYears()>0){%>

 (<%= SafeEncode.forHtml(String.valueOf(demographic_header.getAgeInYears())) %>y)

 <%} %></strong></span>
<span style="padding-right:10px;font-size:14px;"><fmt:setBundle basename="oscarResources"/><fmt:message key="demographic.patient.context.sex"/>: <strong><%= SafeEncode.forHtml(demographic_header.getSexDesc()) %></strong></span>
<span style="padding-right:10px;font-size:14px;"><fmt:setBundle basename="oscarResources"/><fmt:message key="demographic.patient.context.hin"/>: <strong><%= SafeEncode.forHtml(demographic_header.getHin()) %></strong></span>

</div>
</div>
<% } %>
