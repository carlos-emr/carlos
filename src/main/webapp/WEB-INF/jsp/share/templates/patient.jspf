# complete code
<%@ page import="java.util.*, java.io.*" %>
<%@ taglib prefix="carlos" uri="http://carlos-emr/carlos/tags" %>

<%
    String demographic_header = (String) request.getAttribute("demographic_header");
    String d = (String) request.getAttribute("d");
    String alert = (String) request.getAttribute("alert");
%>

<h4 class="DoNotPrint">
    <a href="<carlos:encode value="<%= d %>" context="uriComponent"/>/demographic/DemographicEdit?demographic_no=<carlos:encode value="<%= d %>" context="uriComponent"/>">
        <carlos:encode value="<%= demographic_header.getLastName() %>" context="html"/>
        , <carlos:encode value="<%= demographic_header.getFirstName() %>" context="html"/>
        <% if (demographic_header.getTitle() != null && !demographic_header.getTitle().isEmpty()) { %>
            (<carlos:encode value="<%= demographic_header.getTitle() %>" context="html"/>)
        <% } %>
    </a>
</h4>

<% if (alert != null && !alert.isEmpty()) { %>
    <a title="<carlos:encode value="<%= alert %>" context="htmlAttribute"/>">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </a>
<% } %>

<h4 class="print">
    <carlos:encode value="<%= demographic_header.getLastName() %>" context="html"/>
    , <carlos:encode value="<%= demographic_header.getFirstName() %>" context="html"/>
</h4>