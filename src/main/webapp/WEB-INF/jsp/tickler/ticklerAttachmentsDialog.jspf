<%--
    ticklerAttachmentsDialog.jspf - the shared attachment picker as a jQuery UI dialog (#3984)

    Static include; place it AFTER the tickler <form name="serviceform"> and after
    ticklerAttachmentsPanel.jspf. Needs jQuery, jQuery UI (dialog) and Bootstrap already loaded
    by the host page. Loads previewDocs?method=fetchTicklerDocuments for the tickler's patient,
    pre-checks the picker from the form's ".delegateAttachment" inputs, and on Save and Close
    rewrites those inputs from the checked boxes, updates the visible name lists and sets the
    attachmentsSubmitted marker. Restricted delegates (types the reader cannot open) are kept.

    @since 2026-09-26
--%>
<%@ taglib uri="jakarta.tags.fmt" prefix="fmt" %>
<%@ taglib uri="carlos" prefix="carlos" %>
<fmt:setBundle basename="oscarResources"/>
<fmt:message var="ticklerAttachmentsSaveAndCloseText" key="encounter.oscarConsultationRequest.ConsultationFormRequest.btnSaveAndClose"/>
<fmt:message var="ticklerAttachmentsSelectPatientText" key="tickler.attachments.selectPatientFirst"/>
<div id="attachDocumentDisplay" style="display:none;"></div>
<jsp:include page="/WEB-INF/jsp/includes/spinner.jspf" flush="true"/>
<script type="text/javascript">
    (function () {
        var ctx = '<carlos:encode value='<%= request.getContextPath() %>' context="javaScriptBlock"/>';
        var saveAndCloseText = '${carlos:forJavaScript(ticklerAttachmentsSaveAndCloseText)}';
        var selectPatientText = '${carlos:forJavaScript(ticklerAttachmentsSelectPatientText)}';

        jQuery(document).on('click', '#manageAttachmentsBtn', function () {
            var $form = jQuery('form[name="serviceform"]');
            var trigger = jQuery(this);
            // The Edit window knows its patient; the Add window may pick one after the page
            // loaded, so its own hidden demographic_no input is authoritative at click time.
            var demographicNo = trigger.data('demographicNo') || $form.find('input[name="demographic_no"]').val();
            if (!demographicNo) {
                alert(selectPatientText);
                return;
            }
            var poload = ctx + '/previewDocs?method=fetchTicklerDocuments&demographicNo=' + encodeURIComponent(demographicNo);
            // Only a picker that actually rendered may replace the form's selection: closing a
            // dialog whose load failed (or is still in flight) must not detach anything.
            var pickerLoaded = false;

            jQuery('#attachDocumentDisplay').load(poload, function (response, status) {
                if (status !== 'success' || jQuery('#attachDocumentsForm').length === 0) {
                    return;
                }
                pickerLoaded = true;
                // Pre-check the picker for everything already on the form. The delegate names
                // the checkbox id it mirrors (labs include their source: labNoHL7123).
                $form.find('.delegateAttachment').each(function () {
                    var pickerId = jQuery(this).attr('data-picker-id') || (this.name + this.value);
                    var element = jQuery('#attachDocumentsForm').find('#' + jQuery.escapeSelector(pickerId));
                    if (element.length === 0) {
                        return;
                    }
                    element.prop('checked', true);
                    // Older lab versions sit in a collapsed list; show the one that is attached.
                    if (element.attr('data-version') && typeof expandLabVersionList === 'function') {
                        expandLabVersionList(element.closest('.lab').find('.collapse-arrow'));
                    }
                });
            }).dialog({
                title: trigger.attr('title'),
                modal: true,
                closeText: saveAndCloseText,
                height: 'auto',
                width: 'auto',
                resizable: true,
                open: function () {
                    jQuery(this).parent().css({top: 0, left: 0});
                    var closeBtn = jQuery(this).parent().find('.ui-dialog-titlebar-close');
                    closeBtn.removeClass('ui-button-icon-only');
                    closeBtn.addClass('save-and-close-button');
                    closeBtn.text(saveAndCloseText);
                },
                beforeClose: function () {
                    if (!pickerLoaded) {
                        // Nothing was shown, so nothing was chosen: leave the stored selection
                        // and the attachmentsSubmitted marker exactly as they were.
                        return;
                    }
                    // Rebuild the form's selection from the picker. The action synchronises each
                    // type against the stored set, so submitting the full current selection is
                    // sufficient for both adds and removals. Restricted delegates are types this
                    // reader cannot see in the picker; they must survive the rebuild.
                    $form.find('.delegateAttachment:not([data-restricted])').remove();
                    jQuery('#attachmentNames ul li:not(.restricted)').remove();
                    jQuery('#attachDocumentsForm')
                        .find('.document_check:checked, .lab_check:checked, .form_check:checked, .eForm_check:checked, .hrm_check:checked')
                        .not('[disabled]')
                        .each(function () {
                            var element = jQuery(this);
                            // Lab ids are only unique per source, so a lab is submitted as
                            // "<source>:<id>" (the action reads a bare id as HL7).
                            var labType = element.attr('data-lab-type');
                            var value = element.hasClass('lab_check') && labType
                                ? labType + ':' + element.val()
                                : element.val();
                            jQuery('<input />', {
                                type: 'hidden',
                                name: element.attr('name'),
                                value: value,
                                'data-picker-id': element.attr('id'),
                                id: 'delegate_' + element.attr('id'),
                                'class': 'delegateAttachment'
                            }).appendTo($form.find('.tickler-attachments'));
                            jQuery('<li>').text(element.attr('title')).appendTo('#attachmentNames_' + element.attr('name'));
                        });
                    jQuery('#attachmentNames .attachment-group').each(function () {
                        jQuery(this).toggle(jQuery(this).find('li').length > 0);
                    });
                    jQuery('#attachmentCount').text($form.find('.delegateAttachment').length);
                    jQuery('#attachmentsSubmitted').val('1');
                }
            });
        });
    })();
</script>
