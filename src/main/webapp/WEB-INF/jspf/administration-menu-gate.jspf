<%--
    Purpose: decide whether the schedule menus offer Schedule > Administration. Included (static
    include) by provider/appointmentprovideradminday.jsp and provider/mainMenu.jsp, which wrap the
    link in <c:if test="${canOpenAdministration}">.
    Gate: read on ANY of the objects below, each checked by its own oscarSec tag. One tag naming them
    all keeps ONE privilege per role across the objects (the last row the database returns), so the
    seeded doctor role's `_admin.reporting` `o` row (migration V1.0.6) could hide the link its
    `_admin.flowsheet` `r` earns, depending only on row order (issues #4238 and #4623).
    The list is the one the menus used before; ViewAdministrationIndex2Action admits a subset of it.
    Requires: the including page's roleName$ ("userrole,user") and its c and security taglibs.
    Sets: page-scope boolean canOpenAdministration.
    @since 2026-10-22
--%>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<%@ taglib uri="/WEB-INF/security.tld" prefix="security" %>
<c:set var="canOpenAdministration" value="${false}" />
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.userAdmin" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.schedule" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.billing" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.resource" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.reporting" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.backup" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.messenger" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.eform" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.encounter" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.misc" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.fax" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
<security:oscarSec roleName="<%=roleName$%>" objectName="_admin.flowsheet" rights="r"><c:set var="canOpenAdministration" value="${true}" /></security:oscarSec>
