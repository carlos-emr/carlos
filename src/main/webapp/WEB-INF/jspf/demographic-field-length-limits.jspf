    Shared demographic field length limits fragment.

    Purpose:
    Provides one reusable JavaScript block for demographic add/edit pages so
    client-side maxlength attributes stay aligned across both views.

    Features:
    - Uses server-derived Demographic, DemographicCust and WaitingList max-length constants
    - Counts the alert and the waiting-list note in Unicode code points, like the names, with each
      textarea line break as the two characters (CR LF) the browser submits (#5869)
    - Applies limits on DOMContentLoaded so fields are updated after page markup loads
    - Safely no-ops on pages where a particular field is not rendered

    @since 2026-04-21
--%>
<%@ taglib uri="jakarta.tags.fmt" prefix="fmt" %>
<%@ taglib uri="carlos" prefix="carlos" %>
<fmt:setBundle basename="oscarResources" var="demographicFieldLimitsBundle"/>
<fmt:message key="admin.securityupdate.msgMaximumCharacters" bundle="${demographicFieldLimitsBundle}" var="demographicCodePointLimitMessage"/>
<script type="text/javascript">
    function applyDemographicFieldLengthLimits() {
        var fieldLengthLimits = {
            last_name: <%= Demographic.LAST_NAME_MAX_LENGTH %>,
            first_name: <%= Demographic.FIRST_NAME_MAX_LENGTH %>,
            middleNames: <%= Demographic.MIDDLE_NAMES_MAX_LENGTH %>,
            nameUsed: <%= Demographic.ALIAS_MAX_LENGTH %>,
            pronouns: <%= Demographic.PRONOUN_MAX_LENGTH %>,
            gender: <%= Demographic.GENDER_MAX_LENGTH %>,
            address: <%= Demographic.ADDRESS_MAX_LENGTH %>,
            city: <%= Demographic.CITY_MAX_LENGTH %>,
            year_of_birth: <%= Demographic.YEAR_OF_BIRTH_MAX_LENGTH %>,
            residentialAddress: <%= Demographic.RESIDENTIAL_ADDRESS_MAX_LENGTH %>,
            residentialCity: <%= Demographic.RESIDENTIAL_CITY_MAX_LENGTH %>,
            postal: <%= Demographic.POSTAL_MAX_LENGTH %>,
            residentialPostal: <%= Demographic.RESIDENTIAL_POSTAL_MAX_LENGTH %>,
            phone: <%= Demographic.PHONE_MAX_LENGTH %>,
            phone2: <%= Demographic.PHONE_MAX_LENGTH %>,
            email: <%= Demographic.EMAIL_MAX_LENGTH %>,
            hin: <%= Demographic.HIN_MAX_LENGTH %>,
            ver: <%= Demographic.VER_MAX_LENGTH %>,
            sin: <%= Demographic.SIN_MAX_LENGTH %>,
            chart_no: <%= Demographic.CHART_NO_MAX_LENGTH %>,
            r_doctor: <%= Demographic.REFERRING_DOCTOR_INPUT_MAX_LENGTH %>,
            r_doctor_ohip: <%= Demographic.REFERRING_DOCTOR_OHIP_INPUT_MAX_LENGTH %>,
            // Full class names: add-form-clinical.jsp imports a different WaitingList class.
            alert: <%= io.github.carlos_emr.carlos.commn.model.DemographicCust.ALERT_MAX_LENGTH %>,
            cust3: <%= io.github.carlos_emr.carlos.commn.model.DemographicCust.ALERT_MAX_LENGTH %>,
            waiting_list_note: <%= io.github.carlos_emr.carlos.commn.model.WaitingList.NOTE_MAX_LENGTH %>
        };
        // Fields checked in Unicode code points, as the server counts them, not in UTF-16 units.
        var codePointFields = {
            first_name: true, last_name: true, pronouns: true, gender: true,
            alert: true, cust3: true, waiting_list_note: true
        };

        for (var fieldName in fieldLengthLimits) {
            if (!Object.prototype.hasOwnProperty.call(fieldLengthLimits, fieldName)) {
                continue;
            }

            var fields = document.querySelectorAll('input[name="' + fieldName + '"], textarea[name="' + fieldName + '"]');
            for (var i = 0; i < fields.length; i++) {
                var maximum = fieldLengthLimits[fieldName];
                if (codePointFields[fieldName] === true) {
                    // HTML counts UTF-16 units; native VARCHAR/XSD values count Unicode code points.
                    fields[i].setAttribute('maxlength', maximum * 2);
                    fields[i].setAttribute('data-max-codepoints', maximum);
                    (function (field, limit) {
                        function validateFieldLength() {
                            // A textarea line break reads as LF here but is submitted, and stored, as CR LF.
                            var submitted = (field.value || '').replace(/\r?\n/g, '\r\n');
                            var valid = Array.from(submitted).length <= limit;
                            field.setCustomValidity(valid ? '' : '${carlos:forJavaScript(demographicCodePointLimitMessage)}'.replace('{0}', limit));
                            return valid;
                        }
                        field.addEventListener('input', validateFieldLength);
                        if (field.form) field.form.addEventListener('submit', function (event) {
                            if (!validateFieldLength()) { event.preventDefault(); field.reportValidity(); }
                        });
                        validateFieldLength();
                    })(fields[i], maximum);
                } else {
                    fields[i].setAttribute('maxlength', maximum);
                }
            }
        }
    }

    document.addEventListener('DOMContentLoaded', applyDemographicFieldLengthLimits);
</script>
