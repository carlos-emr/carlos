<%--
    Inline preview row for a PDF embedded in an HL7 ED OBX (#3977).

    Statically included by lab/CA/ALL/labDisplay.jsp and labDisplayAjax.jsp directly after the
    result row's </tr>, so it reads the including page's scriptlet variables:
      embeddedDocument          EmbeddedLabDocumentLoader.Inspection for this OBX, or null
      embeddedDocumentViewHref  the lab/ViewEmbeddedDocumentFromLab URL (not yet encoded)
      labPdfPreviewSettings     LabPdfPreviewSettings, loaded once per page
      labPdfPreviewCount        running count of rendered preview frames on the page (incremented
                                here; an over-limit PDF's note does not count)
      labPdfPreviewColspan      the result table's column count
    The fmt declaration below repeats the including pages' own (same prefix, same URI).

    No script: labDisplayAjax.jsp is inserted into the inbox with innerHTML, where inline scripts
    never run. Lazy loading therefore relies on <details> and loading="lazy": the first
    LAB_PDF_PREVIEWS_OPEN preview frames start expanded, later ones collapsed, and a collapsed frame is
    not fetched until the clinician opens it, so a lab with many PDFs does not load them all.

    @since 2026-09-30
--%>
<%@ taglib uri="jakarta.tags.fmt" prefix="fmt" %>
<%@ taglib uri="carlos" prefix="carlos" %>
<%
    if (embeddedDocument != null && embeddedDocument.isPdf() && labPdfPreviewSettings.inlinePreviewEnabled()) {
        final int LAB_PDF_PREVIEWS_OPEN = 3;
%>
<%-- Same negotiated locale and bundle the including pages set; repeated so the fragment stands
     on its own. Fully qualified because the fragment declares no page imports of its own. --%>
<fmt:setLocale value="<%= io.github.carlos_emr.carlos.utility.LocaleUtils.resolveBundleLocale(request) %>"/>
<fmt:setBundle basename="oscarResources"/>
<tr class="lab-embedded-pdf-row">
    <td colspan="<%= labPdfPreviewColspan %>" style="padding:4px 8px 12px 24px;">
        <% if (embeddedDocument.status() == EmbeddedLabDocumentLoader.Status.TOO_LARGE) { %>
        <%-- Localised text is resolved into page attributes and encoded for its context, like any
             other value written into the page. --%>
        <fmt:message key="lab.embeddedPdf.tooLarge" var="labEmbeddedPdfTooLarge">
            <fmt:param value="<%= String.valueOf((embeddedDocument.sizeBytes() + 1048575) / 1048576) %>"/>
            <fmt:param value="<%= String.valueOf(labPdfPreviewSettings.maxMegabytes()) %>"/>
        </fmt:message>
        <p class="lab-embedded-pdf-too-large" style="margin:0;font-style:italic;"><carlos:encode value="${labEmbeddedPdfTooLarge}"/></p>
        <% } else {
            // Only previews that render a frame take one of the expanded slots: an over-limit
            // PDF above shows a note instead and must not keep a later preview collapsed.
            labPdfPreviewCount++;
        %>
        <fmt:message key="lab.embeddedPdf.preview" var="labEmbeddedPdfPreview"/>
        <fmt:message key="lab.embeddedPdf.frameTitle" var="labEmbeddedPdfFrameTitle"/>
        <fmt:message key="lab.embeddedPdf.fallback" var="labEmbeddedPdfFallback"/>
        <details class="lab-embedded-pdf"<%= labPdfPreviewCount <= LAB_PDF_PREVIEWS_OPEN ? " open" : "" %>>
            <summary style="cursor:pointer;"><carlos:encode value="${labEmbeddedPdfPreview}"/></summary>
            <iframe class="lab-embedded-pdf-frame"
                    src="<%= SafeEncode.forHtmlAttribute(embeddedDocumentViewHref) %>"
                    title="<carlos:encode value="${labEmbeddedPdfFrameTitle}" context="htmlAttribute"/>"
                    loading="lazy"
                    style="width:100%;height:600px;border:1px solid #ccc;"></iframe>
            <div style="font-size:smaller;color:#555;"><carlos:encode value="${labEmbeddedPdfFallback}"/></div>
        </details>
        <% } %>
    </td>
</tr>
<%
    }
%>
