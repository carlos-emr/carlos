<!--
  Struts configuration for RequestBoundaryFilterOrderIntegrationTest (issue #5305). The test loads
  only struts-default.xml and this file. Constants mirror the production struts.xml where they
  decide whether Struts handles a request: extensionless actions, and servlet/JSP paths excluded.
  The logout routes keep their production names so the UserActivityFilter exemptions are
  exercised on the real paths.
-->
<struts>
    <constant name="struts.devMode" value="false"/>
    <constant name="struts.mapper.action.prefix.enabled" value="false"/>
    <constant name="struts.action.extension" value=""/>
    <constant name="struts.enable.SlashesInActionNames" value="true"/>
    <constant name="struts.mapper.alwaysSelectFullNamespace" value="false"/>
    <constant name="struts.actionConfig.fallbackToEmptyNamespace" value="true"/>
    <constant name="struts.action.excludePattern" value=".*\.jsp$|^/servlet/.*"/>

    <package name="request-boundary-test" namespace="/" extends="struts-default">
        <action name="boundary/forwardToJsp"
                class="io.github.carlos_emr.carlos.utility.RequestBoundaryFilterOrderIntegrationTest$LeakingAction">
            <result name="success">/WEB-INF/jsp/boundary/leak.jsp</result>
        </action>
        <action name="boundary/actionFails"
                class="io.github.carlos_emr.carlos.utility.RequestBoundaryFilterOrderIntegrationTest$FailingAction"/>
        <action name="boundary/jspFails"
                class="io.github.carlos_emr.carlos.utility.RequestBoundaryFilterOrderIntegrationTest$LeakingAction">
            <result name="success">/WEB-INF/jsp/boundary/leak-then-fail.jsp</result>
        </action>
        <action name="boundary/transaction"
                class="io.github.carlos_emr.carlos.utility.RequestBoundaryFilterOrderIntegrationTest$TransactionalAction"/>
        <action name="boundary/activity"
                class="io.github.carlos_emr.carlos.utility.RequestBoundaryFilterOrderIntegrationTest$ActivityAction"/>
        <action name="status/SessionHeartbeat"
                class="io.github.carlos_emr.carlos.utility.RequestBoundaryFilterOrderIntegrationTest$ActivityAction"/>
        <action name="logoutPage"
                class="io.github.carlos_emr.carlos.utility.RequestBoundaryFilterOrderIntegrationTest$ActivityAction"/>
        <action name="logout"
                class="io.github.carlos_emr.carlos.utility.RequestBoundaryFilterOrderIntegrationTest$LogoutAction"/>
    </package>
</struts>
