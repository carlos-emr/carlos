<?xml version="1.0" standalone="yes"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="bookingProviderTransfer">
    <xs:sequence>
      <xs:element name="allowedToBook" type="xs:boolean"/>
      <xs:element name="appointmentDurations">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="entry" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="key" minOccurs="0" type="xs:long"/>
                  <xs:element name="value" minOccurs="0" type="xs:int"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="appointmentTypes" type="allowedAppointmentTypeTransfer" nillable="true" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="filterEAF" type="xs:boolean"/>
      <xs:element name="filterFAF" type="xs:boolean"/>
      <xs:element name="filterFAFbuffer" type="xs:int"/>
      <xs:element name="filterMUF" type="xs:boolean"/>
      <xs:element name="filterOAF" type="xs:boolean"/>
      <xs:element name="filterOAFCodes" type="xs:string" minOccurs="0"/>
      <xs:element name="filterSCTF" type="xs:boolean"/>
      <xs:element name="filters" type="filterDefinitionTransfer" nillable="true" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="firstName" type="xs:string" minOccurs="0"/>
      <xs:element name="lastName" type="xs:string" minOccurs="0"/>
      <xs:element name="messageUserId" type="xs:string" minOccurs="0"/>
      <xs:element name="providerNo" type="xs:string" minOccurs="0"/>
      <xs:element name="role" type="xs:string" minOccurs="0"/>
      <xs:element name="teamMembers" type="bookingProviderTransfer" nillable="true" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="allowedAppointmentTypeTransfer">
    <xs:sequence>
      <xs:element name="codes" type="xs:unsignedShort" nillable="true" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="duration" type="xs:int"/>
      <xs:element name="id" type="xs:long" minOccurs="0"/>
      <xs:element name="name" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="filterDefinitionTransfer">
    <xs:sequence>
      <xs:element name="filterClassName" type="xs:string" minOccurs="0"/>
      <xs:element name="on" type="xs:boolean"/>
      <xs:element name="params">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="entry" minOccurs="0" maxOccurs="unbounded">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="key" minOccurs="0" type="xs:string"/>
                  <xs:element name="value" minOccurs="0" type="xs:string"/>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>

